{%- liquid
  # Get Spotify URL and CD Cover from settings or use defaults
  assign spotify_url = settings.music_spotify_url | default: 'https://open.spotify.com/playlist/4mtoSf0Fh48ecJHF9MJiG1?si=_l840rJIQM2YWJbwExCXYw&pi=mEFiEApITtuu4'
  
  if settings.music_cover_image
    assign cd_cover = settings.music_cover_image | image_url: width: 200
  else
    assign cd_cover = 'https://cdn.shopify.com/s/files/1/0954/9840/4181/files/cd_cover.png?v=1770504901'
  endif
-%}

<div class="cd-music-player-minimal">
  <a id="cdPlayPause" class="cd-play-btn-minimal" aria-label="Play/Pause" type="button">
    <span id="cd-icon-play">
      <svg width="38" height="38" viewBox="0 0 38 38" fill="white">
        <polygon points="10,7 32,19 10,31"/>
      </svg>
    </span>
  <span id="cd-icon-pause" class="u-hidden">
      <svg width="38" height="38" viewBox="0 0 38 38" fill="white">
        <rect x="10" y="7" width="7" height="24" rx="2"/><rect x="21" y="7" width="7" height="24" rx="2"/>
      </svg>
    </span>
  </a>
  <a
    href="{{ spotify_url }}"
    target="_blank"
    rel="noopener"
    tabindex="0"
    class="cd-link"
  >
    <img
      height="50"
      width="50"
      src="{{ cd_cover }}"
      alt="CD Cover"
      class="cd-cover-minimal"
      id="cdCoverImg"
      draggable="false"
    >
  </a>
  <audio
    id="cdAudioPlayer"
    preload="auto"
    src=""
  ></audio>
</div>
<style>
  .cd-music-player-minimal {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    background: transparent;
    border-radius: 16px;
    padding: 0;
    max-width: 220px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 0;
    margin-bottom: 20px;
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }
  .cd-play-btn-minimal {
    background: none;
    border: none;
    outline: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    -webkit-user-select: none;
  }
  .cd-play-btn-minimal svg polygon {
    transition: fill 0.15s;
  }
  .cd-play-btn-minimal:hover svg polygon {
    fill: var(--color-primary);
  }

  .cd-play-btn-minimal:hover svg rect {
    fill: var(--color-primary);
  }

  .cd-link {
    display: block;
    user-select: none;
    -webkit-user-select: none;
  }

  .cd-cover-minimal {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    box-shadow: 0 2px 8px #000a;
    border: 2px solid #222;
    background: #111;
    object-fit: cover;
    transition: box-shadow 0.2s;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    pointer-events: auto;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
  }
  .cd-cover-minimal.rotating {
    animation: cd-spin 2.5s linear infinite;
  }
  @keyframes cd-spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
</style>
<script>
  // --- SHUFFLE UTILITY ---
  function shuffleArray(array) {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
  }

  // Build tracks from Liquid settings
  const tracks = [
    {%- for i in (1..50) -%}
      {%- capture track_name_key -%}music_track_{{ i }}_name{%- endcapture -%}
      {%- capture track_url_key -%}music_track_{{ i }}_url{%- endcapture -%}
      {%- assign track_name = settings[track_name_key] -%}
      {%- assign track_url = settings[track_url_key] -%}
      {%- if track_name != blank and track_url != blank -%}
        {
          name: {{ track_name | json }},
          url: {{ track_url | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  ].filter(t => t.name && t.url);

  // No fallback tracks: if none configured, tracks remains empty

  // Invalidate browser cache whenever configured playlist changes
  const playlistSignature = tracks.map(function (t) { return t.url; }).join('|');
  const storedSignature = localStorage.getItem('musicPlayerPlaylistSignature');
  if (storedSignature !== playlistSignature) {
    localStorage.setItem('musicPlayerPlaylistSignature', playlistSignature);
    localStorage.removeItem('musicPlayerShuffledOrder');
    localStorage.removeItem('musicPlayerTrack');
    localStorage.removeItem('musicPlayerTime');
  }

  // --- SHUFFLE SESSION LOGIC ---
  function getShuffledOrder() {
    if (tracks.length === 0) return [];
    let order = localStorage.getItem('musicPlayerShuffledOrder');
    if (order) {
      try {
        order = JSON.parse(order);
        if (Array.isArray(order) && order.length === tracks.length && order.every(function (i) { return typeof i === 'number' && i >= 0 && i < tracks.length; })) {
          return order;
        }
      } catch (e) {}
    }
    // If no order or invalid, create new shuffled order
    const arr = Array.from({ length: tracks.length }, function (_, i) { return i; });
    const shuffled = shuffleArray(arr);
    localStorage.setItem('musicPlayerShuffledOrder', JSON.stringify(shuffled));
    return shuffled;
  }

  const shuffledOrder = getShuffledOrder();

  function getTrackByShuffledIndex(idx) {
    if (tracks.length === 0) return null;
    if (typeof idx !== 'number' || isNaN(idx) || idx < 0 || idx >= tracks.length) {
      idx = 0;
    }
    const orderIndex = (shuffledOrder && typeof shuffledOrder[idx] === 'number') ? shuffledOrder[idx] : 0;
    return tracks[orderIndex] || tracks[0];
  }

  document.addEventListener('DOMContentLoaded', function () {
    var audio = document.getElementById('cdAudioPlayer');
    var playBtn = document.getElementById('cdPlayPause');
    var iconPlay = document.getElementById('cd-icon-play');
    var iconPause = document.getElementById('cd-icon-pause');
    var cdCover = document.getElementById('cdCoverImg');

    if (!audio || !playBtn) return;

    if (tracks.length === 0) {
      playBtn.style.display = 'none';
      return;
    }

    // --- TRACK INDEX LOGIC ---
    var savedTrack = parseInt(localStorage.getItem('musicPlayerTrack'), 10);
    var currentTrack = (!isNaN(savedTrack) && savedTrack >= 0 && savedTrack < tracks.length) ? savedTrack : 0; // Default to first in shuffled order
    var savedTime = parseFloat(localStorage.getItem('musicPlayerTime') || '0');
    var wasPaused = localStorage.getItem('musicPlayerPaused') === 'true';

    // Only set track if not already set (prevents reset on navigation)
    function setTrack(idx) {
      if (tracks.length === 0) return;
      if (idx < 0 || idx >= tracks.length) idx = 0;
      currentTrack = idx;
      var trackObj = getTrackByShuffledIndex(currentTrack);
      if (trackObj && audio.src !== trackObj.url) {
        audio.src = trackObj.url;
      }
      localStorage.setItem('musicPlayerTrack', currentTrack);
      // Reset time for new track
      localStorage.setItem('musicPlayerTime', '0');
      savedTime = 0;
      audio.currentTime = 0;
      // If not paused, play immediately
      if (playBtn.getAttribute('data-intent') === 'play' && !audio.paused) {
        audio.play().catch(function () {});
      }
    }
    // Only set initial track if no saved track or index out of range
    if (isNaN(savedTrack) || savedTrack < 0 || savedTrack >= tracks.length) {
      setTrack(currentTrack);
    } else {
      // If the src is not correct (e.g. after navigation), restore it without resetting time
      var trackObj = getTrackByShuffledIndex(currentTrack);
      if (trackObj && audio.src !== trackObj.url) {
        audio.src = trackObj.url;
      }
    }

    // Restore state from localStorage
    var savedTime = parseFloat(localStorage.getItem('musicPlayerTime') || '0');
    var wasPaused = localStorage.getItem('musicPlayerPaused') === 'true';
    
    // Autoplay strategy: try multiple approaches
    if (!wasPaused) {
      playBtn.setAttribute('data-intent', 'play');
      
      // Strategy 1: Try immediate play with low volume
      audio.volume = 0.3;
      var playPromise = audio.play();
      
      if (playPromise !== undefined) {
        playPromise.then(function() {
          // Success! Gradually increase volume
          var vol = 0.3;
          var volumeInterval = setInterval(function() {
            if (vol < 1) {
              vol += 0.1;
              audio.volume = Math.min(vol, 1);
            } else {
              clearInterval(volumeInterval);
            }
          }, 100);
        }).catch(function(error) {
          // Failed, will try on first interaction
          audio.volume = 1;
        });
      }
    } else {
      playBtn.setAttribute('data-intent', 'pause');
    }
    function updateIcons() {
      if (audio.paused) {
        iconPlay.classList.remove('u-hidden');
        iconPause.classList.add('u-hidden');
        cdCover.classList.remove('rotating');
      } else {
        iconPlay.classList.add('u-hidden');
        iconPause.classList.remove('u-hidden');
        cdCover.classList.add('rotating');
      }
    }
    function globalTryPlay(e) {
      if (e && playBtn.contains(e.target)) return;
      // Try to play on first user interaction
      if (audio.paused && localStorage.getItem('musicPlayerPaused') !== 'true') {
        playBtn.setAttribute('data-intent', 'play');
        audio.volume = 1; // Ensure full volume
        audio.play().catch(function () {});
        // Remove listeners after first successful play
        document.removeEventListener('click', globalTryPlay, true);
        document.removeEventListener('touchstart', globalTryPlay, true);
        document.removeEventListener('keydown', globalTryPlay, true);
        document.removeEventListener('scroll', globalTryPlay, true);
      }
    }
    document.addEventListener('click', globalTryPlay, true);
    document.addEventListener('touchstart', globalTryPlay, true);
    document.addEventListener('keydown', globalTryPlay, true);
    document.addEventListener('scroll', globalTryPlay, true);
    audio.addEventListener('ended', function () {
      if (tracks.length === 0) return;
      var nextTrack = (currentTrack + 1) % tracks.length;
      playBtn.setAttribute('data-intent', 'play');
      localStorage.setItem('musicPlayerPaused', 'false');
      setTrack(nextTrack);
      audio.play().catch(function () {});
    });
    playBtn.addEventListener('click', function (e) {
      e.preventDefault();
      if (tracks.length === 0) return;
      if (audio.paused) {
        playBtn.setAttribute('data-intent', 'play');
        localStorage.setItem('musicPlayerPaused', 'false');
        audio.play().catch(function () {});
      } else {
        playBtn.setAttribute('data-intent', 'pause');
        localStorage.setItem('musicPlayerPaused', 'true');
        audio.pause();
      }
    });
    playBtn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ' || e.keyCode === 13 || e.keyCode === 32) {
        e.preventDefault();
        playBtn.click();
      }
    });
    audio.addEventListener('play', function () {
      updateIcons();
      // Only set paused to false if user did not intentionally pause
      if (playBtn.getAttribute('data-intent') === 'play') {
        localStorage.setItem('musicPlayerPaused', 'false');
      }
    });
    audio.addEventListener('pause', function () {
      updateIcons();
      // Only set paused to true if user intentionally paused
      if (playBtn.getAttribute('data-intent') === 'pause') {
        localStorage.setItem('musicPlayerPaused', 'true');
      }
    });
    audio.addEventListener('timeupdate', function () {
      localStorage.setItem('musicPlayerTime', audio.currentTime);
    });
    audio.addEventListener('loadedmetadata', function () {
      if (!isNaN(savedTime) && savedTime > 0 && savedTime < audio.duration) {
        audio.currentTime = savedTime;
      }
      // Always try to play unless user intentionally paused
      if (localStorage.getItem('musicPlayerPaused') !== 'true') {
        playBtn.setAttribute('data-intent', 'play');
        audio.play().catch(function () {});
      } else {
        playBtn.setAttribute('data-intent', 'pause');
        audio.pause();
      }
      updateIcons();
    });
    updateIcons();
  });
</script>
