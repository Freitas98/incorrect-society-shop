{% comment %}
  Virtual Try-On 3D AR Mirror - Incorrect Society
  High-fidelity WebGL 3D Garment Try-On with Real-Time Pose Tracking
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

{%- liquid
  assign prod_handle = product.handle | downcase
  assign prod_title = product.title | downcase

  assign default_shirt = 'grey'
  if prod_handle contains 'burgundy' or prod_handle contains 'maroon' or prod_handle contains 'sinner' or prod_handle contains 'morally' or prod_title contains 'burgundy' or prod_title contains 'maroon' or prod_title contains 'sinner'
    assign default_shirt = 'burgundy'
  endif

  assign secrets_glb_url = 'vto-secrets.glb' | asset_url
  assign sinners_glb_url = 'vto-sinners.glb' | asset_url
-%}

<!-- Virtual Try-On Modal Container -->
<div
  class="vto-modal"
  id="VirtualTryOnModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-default-shirt="{{ default_shirt }}"
  data-secrets-glb="{{ secrets_glb_url }}"
  data-sinners-glb="{{ sinners_glb_url }}"
>
  <!-- Dark Backdrop -->
  <div class="vto-backdrop" data-vto-close></div>

  <!-- Modal Shell -->
  <div class="vto-shell">
    <!-- Clean Minimalist Header -->
    <header class="vto-header">
      <div class="vto-header-brand">
        <span class="vto-brand-text">INCORRECT SOCIETY</span>
        <span class="vto-dot-sep">·</span>
        <span class="vto-item-name" id="vto-item-title">{{ product.title }}</span>
      </div>

      <div class="vto-header-actions">
        <!-- Switch Camera (Front/Rear) -->
        <button
          type="button"
          class="vto-btn-icon"
          id="vto-flip-cam"
          title="Switch Camera"
          aria-label="Switch Camera"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0-4.418-3.582-8-8-8s-8 3.582-8 8c0 2.21 1.004 4.186 2.6 5.5"/>
            <path d="M4 14c0 4.418 3.582 8 8 8s8-3.582 8-8c0-2.21-1.004-4.186-2.6-5.5"/>
            <polyline points="4 2 4 8 10 8"/>
            <polyline points="20 22 20 16 14 16"/>
          </svg>
        </button>

        <!-- Close Button -->
        <button
          type="button"
          class="vto-btn-icon vto-btn-close"
          data-vto-close
          title="Close Mirror"
          aria-label="Close Mirror"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Viewport (Full Bleed Video + Three.js 3D WebGL Canvas) -->
    <div class="vto-viewport" id="vto-viewport">
      <!-- Hidden Video Stream (Source) -->
      <video id="vto-video" playsinline muted autoplay></video>

      <!-- Three.js 3D WebGL Canvas -->
      <canvas id="vto-canvas"></canvas>

      <!-- Minimalist Hairline Loader -->
      <div class="vto-loader" id="vto-loader">
        <div class="vto-spinner"></div>
        <span class="vto-loader-text">LOADING 3D GARMENT...</span>
      </div>

      <!-- Permission Card (if camera blocked) -->
      <div class="vto-permission-card" id="vto-permission-card" style="display: none;">
        <div class="vto-permission-icon">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
            <circle cx="12" cy="13" r="4"/>
          </svg>
        </div>
        <h3 class="vto-permission-title">Camera Access Required</h3>
        <p class="vto-permission-desc">Enable camera permissions in your browser to try on the piece in real time.</p>
        <button type="button" class="vto-action-pill" id="vto-request-cam-btn">
          Enable Camera
        </button>
      </div>

      <!-- Shutter Flash -->
      <div class="vto-flash" id="vto-flash"></div>

      <!-- Photo Preview Modal -->
      <div class="vto-snapshot-overlay" id="vto-snapshot-overlay" style="display: none;">
        <div class="vto-snapshot-modal">
          <img
            id="vto-snapshot-img"
            src="{{ 'vto-grey-front.png' | asset_url }}"
            alt="Snapshot"
            width="1080"
            height="1440"
            loading="lazy"
          >
          <div class="vto-snapshot-actions">
            <a href="#" download="incorrect-society-fit.jpg" id="vto-download-btn" class="vto-pill-btn vto-pill-btn--solid">
              Download Photo
            </a>
            <button type="button" id="vto-retake-btn" class="vto-pill-btn vto-pill-btn--outline">
              Retake
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating Dock Controls (Bottom) -->
    <div class="vto-dock">
      <!-- Top Row: Selectors (Color · Size · View) -->
      <div class="vto-dock-row">
        <!-- Color Switcher -->
        <div class="vto-switch-group vto-color-switch">
          <button
            type="button"
            class="vto-switch-btn{% if default_shirt == 'burgundy' %} active{% endif %}"
            data-shirt="burgundy"
          >
            <span class="vto-dot-color" style="background-color: #511c21;"></span>
            <span>BURGUNDY</span>
          </button>
          <button
            type="button"
            class="vto-switch-btn{% if default_shirt == 'grey' %} active{% endif %}"
            data-shirt="grey"
          >
            <span class="vto-dot-color" style="background-color: #cfd1d0;"></span>
            <span>GREY</span>
          </button>
        </div>

        <!-- Size Pills -->
        <div class="vto-size-group" id="vto-size-pills">
          <button type="button" class="vto-size-pill" data-size="S">S</button>
          <button type="button" class="vto-size-pill active" data-size="M">M</button>
          <button type="button" class="vto-size-pill" data-size="L">L</button>
          <button type="button" class="vto-size-pill" data-size="XL">XL</button>
        </div>

        <!-- View Toggle (Front / Back) -->
        <div class="vto-switch-group vto-view-switch" id="vto-view-toggle">
          <button type="button" class="vto-switch-btn active" data-view="front">FRONT</button>
          <button type="button" class="vto-switch-btn" data-view="back">BACK</button>
        </div>
      </div>

      <!-- Bottom Row: Shutter + Add to Cart -->
      <div class="vto-action-row">
        <button
          type="button"
          class="vto-shutter-btn"
          id="vto-take-photo-btn"
          title="Take Photo"
          aria-label="Take Photo"
        >
          <span class="vto-shutter-inner"></span>
        </button>

        <button
          type="button"
          class="vto-add-cart-btn"
          id="vto-add-cart-btn"
        >
          <span class="vto-add-text">Add to Cart</span>
          <span class="vto-add-price">{% render 'price', amount: current_variant.price, product: product %}</span>
        </button>
      </div>
    </div>
  </div>
</div>
