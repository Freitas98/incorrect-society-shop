{% comment %}Product-specific, local-only virtual try-on. Model keys are explicit, never inferred from colour/title.{% endcomment %}
{%- liquid
  assign candidate_products = collection.products
  if candidate_products == blank or candidate_products.size == 0
    assign candidate_products = collections['secrets-and-sins'].products
  endif
  assign p_secrets = all_products['secrets-white-tee']
  assign p_sinners = all_products['sins-burgundy-tee']
-%}
<dialog class="vto-modal" id="VirtualTryOn-{{ section.id }}" data-vto-dialog aria-labelledby="VtoTitle-{{ section.id }}" aria-describedby="VtoPrivacy-{{ section.id }}">
  <div class="vto-shell">
    <!-- Top Bar / Header -->
    <header class="vto-header">
      <div class="vto-header-brand">
        <span class="vto-eyebrow">INCORRECT SOCIETY</span>
        <h2 id="VtoTitle-{{ section.id }}" class="vto-header-title">
          <span class="vto-title-tag">TRY NOW USING VR</span>
          <span class="vto-header-product-title" data-vto-header-title>{{ product.title | escape }}</span>
        </h2>
      </div>
      <button type="button" class="vto-close" data-vto-action="close" aria-label="{{ 'try_on.close' | t | escape }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Center Stage: 3D Mirror & Real-time Canvas -->
    <div class="vto-stage" data-vto-stage>
      <canvas data-vto-media aria-hidden="true"></canvas>
      <canvas data-vto-canvas role="img" aria-label="{{ 'try_on.view' | t | escape }}"></canvas>
      <canvas data-vto-foreground aria-hidden="true" style="pointer-events:none"></canvas>

      <!-- Status Pill Overlay -->
      <div class="vto-stage-status" data-vto-status-pill>
        <span class="vto-status-dot"></span>
        <span class="vto-status-label" data-vto-status role="status" aria-live="polite">{{ 'try_on.intro' | t }}</span>
      </div>

      <!-- Quick Action Controls on Stage -->
      <div class="vto-stage-actions">
        <button type="button" class="vto-stage-btn vto-btn-flip" data-vto-flip data-vto-action="flip" hidden title="{{ 'try_on.flip' | t | escape }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 16l4-4-4-4M4 8l-4 4 4 4M20 12H4"/>
          </svg>
          <span>{{ 'try_on.flip' | t }}</span>
        </button>
        <button type="button" class="vto-stage-btn vto-btn-save" data-vto-save data-vto-action="save" disabled title="{{ 'try_on.save' | t | escape }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
          <span>{{ 'try_on.save' | t }}</span>
        </button>
      </div>

      <!-- Welcome / Choices Overlay -->
      <div class="vto-choices" data-vto-choices>
        <div class="vto-choices-card">
          <div class="vto-choices-eyebrow">INCORRECT SOCIETY FITTING ROOM</div>
          <h3 class="vto-choices-title">{{ 'try_on.title' | t }}</h3>
          <p class="vto-choices-desc">{{ 'try_on.intro' | t }}</p>
          <div class="vto-choices-actions">
            <button type="button" class="vto-btn-choice-primary" data-vto-camera data-vto-action="camera">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
              <span>{{ 'try_on.camera' | t }}</span>
            </button>
            <button type="button" class="vto-btn-choice-secondary" data-vto-upload data-vto-action="upload">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>{{ 'try_on.upload' | t }}</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Busy / Loading Overlay -->
      <div class="vto-busy" data-vto-busy hidden>
        <div class="vto-spinner" aria-hidden="true"></div>
        <p class="vto-busy-label">{{ 'try_on.loading' | t }}</p>
      </div>
    </div>

    <!-- Right Sidebar / Commerce & Controls -->
    <div class="vto-controls">
      <!-- Active Product Info Card -->
      <div class="vto-product-panel">
        <div class="vto-product-heading-group">
          <span class="vto-section-subtitle">{{ 'try_on.fit.currentPiece' | t }}</span>
          <h3 class="vto-product-name" data-vto-product-name>{{ product.title | escape }}</h3>
          <div class="vto-product-price-row">
            <span class="vto-product-price" data-vto-product-price>{{ product.price | money }}</span>
            <span class="vto-badge-stock" data-vto-stock-badge>{{ 'try_on.fit.available' | t }}</span>
          </div>
        </div>

        <!-- Size Selector -->
        <div class="vto-size-block">
          <div class="vto-size-header">
            <span class="vto-size-title">{{ 'try_on.select_size' | t }}</span>
            <span class="vto-size-active-label" data-vto-active-size-label></span>
          </div>
          <div class="vto-size-options" data-vto-sizes>
            {% for variant in product.variants %}
              <button type="button"
                class="vto-size-btn{% if forloop.first %} active{% endif %}{% unless variant.available %} is-soldout{% endunless %}"
                data-vto-size-btn
                data-variant-id="{{ variant.id }}"
                data-size-title="{{ variant.title | escape }}">
                {{ variant.title | escape }}
              </button>
            {% endfor %}
          </div>
        </div>

        <div class="vto-measurements" data-vto-measurements></div>
        <details class="vto-profile">
          <summary>{{ 'try_on.fit.profile' | t }}</summary>
          <p>{{ 'try_on.fit.profileHint' | t }}</p>
          <label>{{ 'try_on.fit.method' | t }}
            <select data-vto-profile="method">
              <option value="shirt">{{ 'try_on.fit.shirt' | t }}</option>
              <option value="body">{{ 'try_on.fit.body' | t }}</option>
            </select>
          </label>
          <div data-vto-profile-shirt class="vto-profile-fields">
            <p>{{ 'try_on.fit.shirtHint' | t }}</p>
            <label>{{ 'try_on.fit.width' | t }}<input data-vto-profile="width" type="number" min="35" max="90" step="0.5" inputmode="decimal" placeholder="35–90" autocomplete="off"></label>
            <label>{{ 'try_on.fit.length' | t }}<input data-vto-profile="length" type="number" min="40" max="100" step="0.5" inputmode="decimal" placeholder="40–100" autocomplete="off"></label>
          </div>
          <div data-vto-profile-body class="vto-profile-fields" hidden>
            <p>{{ 'try_on.fit.bodyHint' | t }}</p>
            <label>{{ 'try_on.fit.chest' | t }}<input data-vto-profile="chest" type="number" min="60" max="180" step="0.5" inputmode="decimal" placeholder="60–180" autocomplete="off"></label>
            <label>{{ 'try_on.fit.preference' | t }}
              <select data-vto-profile="preference">
                <option value="boxy">{{ 'try_on.fit.boxy' | t }}</option>
                <option value="relaxed">{{ 'try_on.fit.relaxed' | t }}</option>
                <option value="closer">{{ 'try_on.fit.closer' | t }}</option>
              </select>
            </label>
          </div>
          <div class="vto-calibration">
            <span class="vto-section-subtitle">{{ 'try_on.fit.calibration' | t }}</span>
            <label>{{ 'try_on.fit.shoulder' | t }}<input data-vto-profile="shoulder" type="number" min="28" max="65" step="0.5" inputmode="decimal" placeholder="28–65" autocomplete="off"></label>
            <p>{{ 'try_on.fit.shoulderHint' | t }}</p>
          </div>
          <button type="button" class="vto-source-btn" data-vto-clear-profile>{{ 'try_on.fit.reset' | t }}</button>
        </details>
        <div class="vto-fit-advice" data-vto-fit-advice role="status" aria-live="polite"></div>
        <button type="button" class="vto-source-btn" data-vto-use-recommendation hidden>{{ 'try_on.fit.compare' | t }}</button>
        <p class="vto-fit-scale" data-vto-fit-scale>{{ 'try_on.fit.uncalibrated' | t }}</p>
        <!-- Size Guide & Fit Simulation Notice -->
        <div class="vto-size-notice">
          <div class="vto-size-notice-head">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span>{{ 'try_on.size_disclaimer_title' | t }}</span>
          </div>
          <p class="vto-size-notice-text">
            {{ 'try_on.size_disclaimer_body' | t }}
          </p>
        </div>

        <!-- Add To Cart CTA -->
        <button type="button" class="vto-add-to-cart-btn" data-vto-add-cart>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="vto-cart-cta-text" data-vto-cart-cta-text>{{ 'try_on.add_to_cart' | t }}</span>
          <span class="vto-cart-cta-separator">—</span>
          <span class="vto-cart-cta-price" data-vto-cart-cta-price>{{ product.price | money }}</span>
        </button>
        <div class="vto-cart-toast" data-vto-cart-toast role="status" aria-live="polite" hidden></div>
      </div>

      <!-- Suggested Pieces from Collection -->
      <div class="vto-suggested-section">
        <div class="vto-suggested-header">
          <span class="vto-section-subtitle">{{ 'try_on.other_pieces' | t }}</span>
        </div>
        <div class="vto-suggested-grid" data-vto-collection-grid>
          <!-- Dynamic thumbnails populated by JS -->
        </div>
      </div>

      <!-- Source Toggle Buttons (Camera / Photo) - shown once session starts -->
      <div class="vto-source-switchers" data-vto-source-switchers hidden>
        <button type="button" class="vto-source-btn" data-vto-action="camera">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          <span>{{ 'try_on.camera' | t }}</span>
        </button>
        <button type="button" class="vto-source-btn" data-vto-action="upload">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <span>{{ 'try_on.upload' | t }}</span>
        </button>
      </div>

      <label class="vto-quality">{{ 'try_on.fit.quality' | t }}
        <select data-vto-quality>
          <option value="auto">{{ 'try_on.fit.qualityAuto' | t }}</option>
          <option value="lite">{{ 'try_on.fit.qualityLite' | t }}</option>
        </select>
        <span>{{ 'try_on.fit.qualityHint' | t }}</span>
      </label>
      <p class="vto-note">{{ 'try_on.note' | t }}</p>
      <p class="vto-note" data-vto-occlusion-note role="status" hidden>{{ 'try_on.fit.occlusionUnavailable' | t }}</p>
      <p class="vto-privacy" id="VtoPrivacy-{{ section.id }}">{{ 'try_on.privacy' | t }}</p>
      <button class="vto-return" type="button" data-vto-action="product">{{ 'try_on.product' | t }}</button>
    </div>

    <!-- Hidden file input for user photo uploads -->
    <input data-vto-file type="file" accept="image/jpeg,image/png,image/webp" hidden aria-label="{{ 'try_on.upload' | t | escape }}">

    <!-- Single application/json script for configuration -->
    {% capture vto_config %}
    {
      "model": {{ vto_model | json }},
      "workerUrl": {{ 'vto-pose-worker.js' | asset_url | json }},
      "processorUrl": {{ 'vto-pose-processor.js' | asset_url | json }},
      "visionUrl": {{ 'vto-vision.js' | asset_url | json }},
      "models": {
        "secrets": {{ 'vto-secrets.glb' | asset_url | json }},
        "sinners": {{ 'vto-sinners.glb' | asset_url | json }}
      },
      "currentProduct": {
        "optionNames": {{ product.options | json }},
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "price": {{ product.price | json }},
        "priceFormatted": {{ product.price | money | json }},
        "featuredImage": {{ product.featured_image | image_url: width: 300 | json }},
        "model": {{ vto_model | json }}
      },
      "variants": [{% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "priceFormatted": {{ variant.price | money | json }},
          "options": {{ variant.options | json }},
          "model": {{ variant.metafields.custom.try_on_model.value | default: vto_model | json }}
        }{% unless forloop.last %},{% endunless %}{% endfor %}
      ],
      "collectionItems": [
        {%- assign added_item = false -%}
        {%- if candidate_products and candidate_products.size > 0 -%}
          {%- for item in candidate_products -%}
            {%- liquid
              assign item_model = item.metafields.custom.try_on_model.value | default: ''
              if item_model == blank
                case item.id
                  when 11569665933653
                    assign item_model = 'secrets'
                  when 11569666097493
                    assign item_model = 'sinners'
                endcase
              endif
            -%}
            {%- if item_model == 'secrets' or item_model == 'sinners' -%}
              {%- if added_item %},{% endif -%}
              {
                "id": {{ item.id | json }},
                "optionNames": {{ item.options | json }},
                "title": {{ item.title | json }},
                "price": {{ item.price | json }},
                "priceFormatted": {{ item.price | money | json }},
                "featuredImage": {{ item.featured_image | image_url: width: 240 | json }},
                "model": {{ item_model | json }},
                "variants": [{% for v in item.variants %}
                  {
                    "id": {{ v.id | json }},
                    "title": {{ v.title | json }},
                    "available": {{ v.available | json }},
                    "price": {{ v.price | json }},
                    "priceFormatted": {{ v.price | money | json }},
                    "options": {{ v.options | json }},
                    "model": {{ v.metafields.custom.try_on_model.value | default: item_model | json }}
                  }{% unless forloop.last %},{% endunless %}{% endfor %}
                ]
              }
              {%- assign added_item = true -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if added_item == false and p_secrets and p_sinners -%}
          {
            "id": {{ p_secrets.id | json }},
            "optionNames": {{ p_secrets.options | json }},
            "title": {{ p_secrets.title | json }},
            "price": {{ p_secrets.price | json }},
            "priceFormatted": {{ p_secrets.price | money | json }},
            "featuredImage": {{ p_secrets.featured_image | image_url: width: 240 | json }},
            "model": "secrets",
            "variants": [{% for v in p_secrets.variants %}
              {
                "id": {{ v.id | json }},
                "title": {{ v.title | json }},
                "available": {{ v.available | json }},
                "price": {{ v.price | json }},
                "priceFormatted": {{ v.price | money | json }},
                "options": {{ v.options | json }},
                "model": "secrets"
              }{% unless forloop.last %},{% endunless %}{% endfor %}
            ]
          },
          {
            "id": {{ p_sinners.id | json }},
            "optionNames": {{ p_sinners.options | json }},
            "title": {{ p_sinners.title | json }},
            "price": {{ p_sinners.price | json }},
            "priceFormatted": {{ p_sinners.price | money | json }},
            "featuredImage": {{ p_sinners.featured_image | image_url: width: 240 | json }},
            "model": "sinners",
            "variants": [{% for v in p_sinners.variants %}
              {
                "id": {{ v.id | json }},
                "title": {{ v.title | json }},
                "available": {{ v.available | json }},
                "price": {{ v.price | json }},
                "priceFormatted": {{ v.price | money | json }},
                "options": {{ v.options | json }},
                "model": "sinners"
              }{% unless forloop.last %},{% endunless %}{% endfor %}
            ]
          }
        {%- endif -%}
      ],
      "liteModels": {"secrets": {{ 'vto-secrets-lite.glb' | asset_url | json }}, "sinners": {{ 'vto-sinners-lite.glb' | asset_url | json }}},
      "occlusionUrl": {{ 'vto-occlusion.js' | asset_url | json }},
      "segmentationUrl": {{ 'vto-segmentation.js' | asset_url | json }},
      "measurements": {% render 'size-measurements', action: 'json', garment: 'tshirt' %},
      "fitStrings": {
        "profile": {{ 'try_on.fit.profile' | t | json }},
        "profileHint": {{ 'try_on.fit.profileHint' | t | json }},
        "method": {{ 'try_on.fit.method' | t | json }},
        "shirt": {{ 'try_on.fit.shirt' | t | json }},
        "body": {{ 'try_on.fit.body' | t | json }},
        "width": {{ 'try_on.fit.width' | t | json }},
        "length": {{ 'try_on.fit.length' | t | json }},
        "chest": {{ 'try_on.fit.chest' | t | json }},
        "preference": {{ 'try_on.fit.preference' | t | json }},
        "closer": {{ 'try_on.fit.closer' | t | json }},
        "relaxed": {{ 'try_on.fit.relaxed' | t | json }},
        "boxy": {{ 'try_on.fit.boxy' | t | json }},
        "bodyHint": {{ 'try_on.fit.bodyHint' | t | json }},
        "shirtHint": {{ 'try_on.fit.shirtHint' | t | json }},
        "calibration": {{ 'try_on.fit.calibration' | t | json }},
        "shoulder": {{ 'try_on.fit.shoulder' | t | json }},
        "shoulderHint": {{ 'try_on.fit.shoulderHint' | t | json }},
        "calibrated": {{ 'try_on.fit.calibrated' | t | json }},
        "uncalibrated": {{ 'try_on.fit.uncalibrated' | t | json }},
        "incomplete": {{ 'try_on.fit.incomplete' | t | json }},
        "match": {{ 'try_on.fit.match' | t | json }},
        "outside": {{ 'try_on.fit.outside' | t | json }},
        "unsupported": {{ 'try_on.fit.unsupported' | t | json }},
        "difference": {{ 'try_on.fit.difference' | t | json }},
        "ease": {{ 'try_on.fit.ease' | t | json }},
        "tie": {{ 'try_on.fit.tie' | t | json }},
        "tolerance": {{ 'try_on.fit.tolerance' | t | json }},
        "soldout": {{ 'try_on.fit.soldout' | t | json }},
        "compare": {{ 'try_on.fit.compare' | t | json }},
        "reset": {{ 'try_on.fit.reset' | t | json }},
        "measurements": {{ 'try_on.fit.measurements' | t | json }},
        "sleeve": {{ 'try_on.fit.sleeve' | t | json }},
        "garmentShoulder": {{ 'try_on.fit.garmentShoulder' | t | json }},
        "opening": {{ 'try_on.fit.opening' | t | json }},
        "available": {{ 'try_on.fit.available' | t | json }},
        "currentPiece": {{ 'try_on.fit.currentPiece' | t | json }},
        "cartError": {{ 'try_on.fit.cartError' | t | json }},
        "cartRefresh": {{ 'try_on.fit.cartRefresh' | t | json }},
        "cartUnknown": {{ 'try_on.fit.cartUnknown' | t | json }},
        "viewCart": {{ 'try_on.fit.viewCart' | t | json }},
        "invalid": {{ 'try_on.fit.invalid' | t | json }}
      },
      "strings": {
        "title": {{ 'try_on.title' | t | json }},
        "close": {{ 'try_on.close' | t | json }},
        "camera": {{ 'try_on.camera' | t | json }},
        "upload": {{ 'try_on.upload' | t | json }},
        "flip": {{ 'try_on.flip' | t | json }},
        "save": {{ 'try_on.save' | t | json }},
        "product": {{ 'try_on.product' | t | json }},
        "intro": {{ 'try_on.intro' | t | json }},
        "loading": {{ 'try_on.loading' | t | json }},
        "searching": {{ 'try_on.searching' | t | json }},
        "tracking": {{ 'try_on.tracking' | t | json }},
        "photoFitted": {{ 'try_on.photoFitted' | t | json }},
        "unsupported": {{ 'try_on.unsupported' | t | json }},
        "engineError": {{ 'try_on.engineError' | t | json }},
        "cameraUnavailable": {{ 'try_on.cameraUnavailable' | t | json }},
        "cameraDenied": {{ 'try_on.cameraDenied' | t | json }},
        "cameraError": {{ 'try_on.cameraError' | t | json }},
        "invalidPhoto": {{ 'try_on.invalidPhoto' | t | json }},
        "webglLost": {{ 'try_on.webglLost' | t | json }},
        "ease": {{ 'try_on.ease' | t | json }},
        "length": {{ 'try_on.length' | t | json }},
        "privacy": {{ 'try_on.privacy' | t | json }},
        "note": {{ 'try_on.note' | t | json }},
        "adjust": {{ 'try_on.adjust' | t | json }},
        "view": {{ 'try_on.view' | t | json }},
        "addToCart": {{ 'try_on.add_to_cart' | t | json }},
        "addingToCart": {{ 'try_on.adding_to_cart' | t | json }},
        "addedToCart": {{ 'try_on.added_to_cart' | t | json }},
        "selectSize": {{ 'try_on.select_size' | t | json }},
        "size": {{ 'try_on.size' | t | json }},
        "otherPieces": {{ 'try_on.other_pieces' | t | json }},
        "tryPiece": {{ 'try_on.try_piece' | t | json }},
        "outOfStock": {{ 'try_on.out_of_stock' | t | json }},
        "sizeDisclaimerTitle": {{ 'try_on.size_disclaimer_title' | t | json }},
        "sizeDisclaimerBody": {{ 'try_on.size_disclaimer_body' | t | json }}
      }
    }
    {% endcapture %}
    {%- capture vto_lt_escape -%}\u003c{%- endcapture -%}
    <script type="application/json" data-vto-config>{{ vto_config | replace: '<', vto_lt_escape }}</script>
  </div>
</dialog>
