{% if settings.enable_drop_features and settings.drop_bundle_product != blank %}
  <section class="drop-bundle-section" aria-labelledby="DropBundleTitle-{{ section.id }}">
    <div class="drop-bundle-section__inner">
      <p class="drop-bundle-section__eyebrow">{{ 'drop.bundle_page_eyebrow' | t }}</p>
      <h2 id="DropBundleTitle-{{ section.id }}">{{ 'drop.bundle_page_title' | t }}</h2>
      {% render 'drop-bundle-card', home_bundle: true %}
    </div>
  </section>

  <style>
    .drop-bundle-section { padding: 72px 24px; background: var(--color-background, #fff); color: var(--color-foreground, #111); }
    .drop-bundle-section__inner { width: min(100%, 920px); margin: 0 auto; }
    .drop-bundle-section__eyebrow { margin: 0 0 8px; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .drop-bundle-section h2 { max-width: 560px; margin: 0 0 28px; font-size: clamp(1.65rem, 4vw, 3.25rem); line-height: .98; letter-spacing: -.04em; text-transform: uppercase; }
    .drop-bundle-section .drop-bundle-card { display: grid; grid-template-columns: minmax(220px, .8fr) minmax(0, 1fr); gap: clamp(22px, 5vw, 52px); padding: clamp(18px, 4vw, 36px); overflow: hidden; border: 1px solid var(--color-border, #d8d8d8); background: var(--color-surface, #f5f5f5); }
    .drop-bundle-section .drop-bundle-card__offer { grid-column: 1 / -1; width: 100%; margin: 0; padding: 8px 12px; background: #8f173d; color: #fff; font-size: 9px; font-weight: 700; letter-spacing: .1em; line-height: 1; text-align: center; text-transform: uppercase; }
    .drop-bundle-section .drop-bundle-card__offer span { margin-right: 3px; color: #f3b15c; }
    .drop-bundle-section .drop-bundle-card__images { position: relative; min-height: 285px; isolation: isolate; }
    .drop-bundle-section .drop-bundle-card__images img { position: absolute; width: 65%; height: 84%; object-fit: contain; filter: drop-shadow(0 10px 12px rgba(0, 0, 0, .14)); }
    .drop-bundle-section .drop-bundle-card__images img:first-child { top: 0; left: 0; z-index: 1; transform: rotate(-3deg); }
    .drop-bundle-section .drop-bundle-card__images img:last-child { right: 0; bottom: 0; z-index: 2; transform: rotate(3deg); }
    .drop-bundle-section .drop-bundle-card__content { display: flex; flex-direction: column; align-items: flex-start; }
    .drop-bundle-section .drop-bundle-card__eyebrow, .drop-bundle-section .drop-bundle-card__copy, .drop-bundle-section .drop-bundle-card__shipping, .drop-bundle-section .drop-bundle-card__status { margin: 0; }
    .drop-bundle-section .drop-bundle-card__eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .09em; }
    .drop-bundle-section .drop-bundle-card__copy { margin-top: 7px; font-size: 15px; line-height: 1.45; }
    .drop-bundle-section .drop-bundle-card__sizes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; width: 100%; margin-top: 18px; }
    .drop-bundle-section .drop-bundle-card__sizes label { display: grid; gap: 6px; min-width: 0; font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
    .drop-bundle-section .drop-bundle-card__sizes select { width: 100%; min-height: 42px; padding: 8px 28px 8px 10px; border: 1px solid var(--color-border, #999); border-radius: 0; background: var(--color-background, #fff); color: inherit; font: inherit; }
    .drop-bundle-section .drop-bundle-card__shipping { margin-top: 14px; font-size: 12px; font-weight: 700; }
    .drop-bundle-section .drop-bundle-card__button { display: flex; width: 100%; justify-content: space-between; gap: 12px; margin-top: 16px; padding: 14px; border: 0; background: var(--color-foreground, #111); color: var(--color-background, #fff); font: inherit; font-size: 11px; font-weight: 700; letter-spacing: .07em; cursor: pointer; }
    .drop-bundle-section .drop-bundle-card__button:disabled { cursor: not-allowed; opacity: .52; }
    .drop-bundle-section .drop-bundle-card__status { margin-top: 9px; color: var(--color-error, #b91c1c); font-size: 12px; }
    @media (max-width: 640px) { .drop-bundle-section { padding: 48px 18px; } .drop-bundle-section .drop-bundle-card { display: block; padding: 14px; } .drop-bundle-section .drop-bundle-card__images { display: none; } .drop-bundle-section .drop-bundle-card__content { margin-top: 11px; } .drop-bundle-section .drop-bundle-card__sizes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  </style>
{% endif %}

{% schema %}
{
  "name": "Drop bundle",
  "settings": [],
  "presets": [{ "name": "Drop bundle" }]
}
{% endschema %}
