{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{%- liquid
  assign vto_model = product.metafields.custom.try_on_model.value | default: ''
  if vto_model == blank
    comment
      Exact product identities confirmed by the merchant; never infer from title/colour.
    endcomment
    case product.id
      when 11569665933653
        assign vto_model = 'secrets'
      when 11569666097493
        assign vto_model = 'sinners'
    endcase
  endif
  if section.settings.vto_secrets_product.id == product.id
    assign vto_model = 'secrets'
  elsif section.settings.vto_sinners_product.id == product.id
    assign vto_model = 'sinners'
  endif
  assign vto_available = false
  if vto_model == 'secrets' or vto_model == 'sinners'
    assign vto_available = true
  endif
  for variant in product.variants
    if variant.metafields.custom.try_on_model.value == 'secrets' or variant.metafields.custom.try_on_model.value == 'sinners'
      assign vto_available = true
    endif
  endfor
  if section.settings.enable_virtual_try_on == false or settings.enable_virtual_try_on == false
    assign vto_available = false
  endif

  assign is_current_drop_product = false
  if settings.enable_drop_features and settings.drop_collection != blank
    for product_collection in product.collections
      if product_collection.id == settings.drop_collection.id
        assign is_current_drop_product = true
        break
      endif
    endfor
  endif

  assign bundle_available_for_product = false
  assign is_bundle_product = false
  if settings.enable_drop_features and settings.drop_bundle_product != blank
    if product.id == settings.drop_bundle_product.id or product.handle == settings.drop_bundle_product.handle or product.handle == settings.drop_bundle_product
      assign is_bundle_product = true
    elsif product.id == settings.drop_bundle_component_one.id or product.handle == settings.drop_bundle_component_one.handle or product.handle == settings.drop_bundle_component_one
      assign bundle_available_for_product = true
    elsif product.id == settings.drop_bundle_component_two.id or product.handle == settings.drop_bundle_component_two.handle or product.handle == settings.drop_bundle_component_two
      assign bundle_available_for_product = true
    endif
  endif
-%}

<div class="product-page-new{% if product.gift_card? or product.type == 'Gift Card' %} product-page--gift-card{% endif %}" data-product-commerce data-low-stock-enabled="{% if settings.enable_drop_features and settings.show_low_stock %}true{% else %}false{% endif %}" data-low-stock-ratio="{{ settings.low_stock_ratio | default: 67 }}" data-bundle-enabled="{{ bundle_available_for_product | json }}">
  
  <!-- Left Column: Product Info -->
  <div class="product-col-left">
    <nav class="product-breadcrumb">
      {% if is_bundle_product %}
        {% assign drop_collection = collections[settings.drop_collection] %}
        {% assign drop_collection_url = drop_collection.url | default: settings.drop_collection.url %}
        {% if drop_collection_url == blank and product.collections.size > 0 %}
          {% assign drop_collection_url = product.collections.first.url %}
        {% endif %}
        {% if drop_collection_url == blank %}
          {% assign drop_collection_url = '/collections/secrets-and-sins' %}
        {% endif %}
        {% assign drop_collection_title = drop_collection.title | default: settings.drop_collection.title %}
        {% if drop_collection_title == blank and product.collections.size > 0 %}
          {% assign drop_collection_title = product.collections.first.title %}
        {% endif %}
        {% if drop_collection_title == blank %}
          {% assign drop_collection_title = 'Secrets And Sins' %}
        {% endif %}
        <a href="{{ drop_collection_url }}">{{ drop_collection_title }}</a>
        <span>/</span>
        <span>BUNDLES</span>
      {% elsif product.collections.size > 0 %}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span>/</span>
        <span>{{ product.title }}</span>
      {% else %}
        <span>{{ product.title }}</span>
      {% endif %}
    </nav>
    
    <div class="product-title-row">
      <h1 class="product-title">{{ product.title }}</h1>
      <span class="product-price">{% render 'price', amount: current_variant.price, product: product %}</span>
    </div>
    
    <!-- Product Info Sections -->
    <div class="product-info-sections">
      {% if product.description != blank %}
      <div class="info-section-static">
        <h3 class="info-section-title">DESCRIPTION</h3>
        <div class="info-section-body">
          {{ product.description }}
        </div>
      </div>
      {% endif %}
      
      {% if product.metafields.custom.details != blank %}
      <div class="info-section-static">
        <h3 class="info-section-title">PRODUCT DETAILS</h3>
        <div class="info-section-body">
          {{ product.metafields.custom.details | metafield_tag | newline_to_br }}
        </div>
      </div>
      {% endif %}
      
      <div class="info-section-static">
        <a href="{{ pages['shipping-policy'].url | default: '/pages/shipping-policy' }}" class="info-link">{{ 'policies.shipping_policy' | t }}</a>
      </div>

      {% if is_bundle_product %}
        <div class="info-section-static product-bundle-page-info">
          <h3 class="info-section-title">{{ 'drop.bundle_page_title' | t }}</h3>
          <div class="info-section-body">
            <p>{{ 'drop.bundle_page_copy' | t }}</p>
            <p>{{ 'drop.bundle_free_shipping' | t }}</p>
          </div>
        </div>
      {% endif %}
      
      {% unless product.gift_card? or product.type == 'Gift Card' or product.type == "Accessories" %}
      <div class="info-section-static size-guide-section">
        <div class="size-guide-row">
          <a href="/pages/size-guide" class="info-link size-guide-link-text">Size Guide</a>
          <button type="button" class="size-guide-info-btn" aria-label="View size guide popup">
            +
          </button>
        </div>
        <div class="size-guide-popup">
          
          <button type="button" class="size-guide-close" aria-label="Close">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
          <div class="size-guide-header">
            <span class="size-guide-popup-title">Size Guide</span>
            <div class="unit-toggle">
              <button type="button" class="unit-btn active" data-unit="cm">CM</button>
              <button type="button" class="unit-btn" data-unit="inches">IN</button>
            </div>
          </div>
          
          {% assign product_type_down = product.type | downcase %}
          {% assign product_title_down = product.title | downcase %}
          
          {% comment %} Determine garment type {% endcomment %}
          {% assign garment_type = 'tshirt' %}
          {% assign garment_name = 'Yellow Tee' %}
          {% assign diagram_file = 'yellow tee.svg' %}
          {% assign has_xs = false %}
          
          {% if product_type_down contains 'zip' or product_type_down contains 'hoodie' or product_title_down contains 'zip' %}
            {% assign garment_type = 'hoodie' %}
            {% assign garment_name = 'Black Zip Up' %}
            {% assign diagram_file = 'zip-hoodie.svg' %}
          {% elsif product_type_down contains 'longsleeve' or product_type_down contains 'long sleeve' or product_title_down contains 'longsleeve' or product_title_down contains 'long sleeve' %}
            {% assign garment_type = 'longsleeve' %}
            {% assign garment_name = 'Too Scared Longsleeve' %}
            {% assign diagram_file = 'too scared long sleeve.svg' %}
          {% elsif product_type_down contains 'baby' or product_title_down contains 'baby' %}
            {% assign garment_type = 'babytee' %}
            {% assign garment_name = 'Baby Blue Tee' %}
            {% assign diagram_file = 'baby blue tee.svg' %}
            {% assign has_xs = true %}
          {% endif %}
          
          <div class="size-guide-content">
            <div class="size-guide-table-wrapper">
              {% if has_xs %}
                <div class="size-guide-table" data-unit="cm">
                  <div class="size-row header">
                    <span>Size</span><span>A (Length)</span><span>B (Sleeve)</span><span>C (Chest)</span>
                  </div>
                  <div class="size-row"><span>XS</span><span>{% render 'size-measurements', garment: 'babytee', size: 'xs', point: 'a', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'xs', point: 'b', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'xs', point: 'c', unit: 'cm' %}</span></div>
                  <div class="size-row"><span>S</span><span>{% render 'size-measurements', garment: 'babytee', size: 's', point: 'a', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 's', point: 'b', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 's', point: 'c', unit: 'cm' %}</span></div>
                  <div class="size-row"><span>M</span><span>{% render 'size-measurements', garment: 'babytee', size: 'm', point: 'a', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'm', point: 'b', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'm', point: 'c', unit: 'cm' %}</span></div>
                  <div class="size-row"><span>L</span><span>{% render 'size-measurements', garment: 'babytee', size: 'l', point: 'a', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'l', point: 'b', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'l', point: 'c', unit: 'cm' %}</span></div>
                </div>
                <div class="size-guide-table" data-unit="inches" style="display:none;">
                  <div class="size-row header">
                    <span>Size</span><span>A (Length)</span><span>B (Sleeve)</span><span>C (Chest)</span>
                  </div>
                  <div class="size-row"><span>XS</span><span>{% render 'size-measurements', garment: 'babytee', size: 'xs', point: 'a', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'xs', point: 'b', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'xs', point: 'c', unit: 'inches' %}</span></div>
                  <div class="size-row"><span>S</span><span>{% render 'size-measurements', garment: 'babytee', size: 's', point: 'a', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 's', point: 'b', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 's', point: 'c', unit: 'inches' %}</span></div>
                  <div class="size-row"><span>M</span><span>{% render 'size-measurements', garment: 'babytee', size: 'm', point: 'a', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'm', point: 'b', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'm', point: 'c', unit: 'inches' %}</span></div>
                  <div class="size-row"><span>L</span><span>{% render 'size-measurements', garment: 'babytee', size: 'l', point: 'a', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'l', point: 'b', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'babytee', size: 'l', point: 'c', unit: 'inches' %}</span></div>
                </div>
              {% elsif garment_type == 'tshirt' %}
                <div class="size-guide-table size-guide-table--5-points" data-unit="cm">
                  <div class="size-row header">
                    <span>Size</span><span>Chest</span><span>Length</span><span>Sleeve</span><span>Shoulder</span><span>Opening</span>
                  </div>
                  <div class="size-row"><span>S</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'chest', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'length', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'sleeve', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'shoulder', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'opening', unit: 'cm' %}</span></div>
                  <div class="size-row"><span>M</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'chest', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'length', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'sleeve', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'shoulder', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'opening', unit: 'cm' %}</span></div>
                  <div class="size-row"><span>L</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'chest', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'length', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'sleeve', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'shoulder', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'opening', unit: 'cm' %}</span></div>
                  <div class="size-row"><span>XL</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'chest', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'length', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'sleeve', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'shoulder', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'opening', unit: 'cm' %}</span></div>
                </div>
                <div class="size-guide-table size-guide-table--5-points" data-unit="inches" style="display:none;">
                  <div class="size-row header">
                    <span>Size</span><span>Chest</span><span>Length</span><span>Sleeve</span><span>Shoulder</span><span>Opening</span>
                  </div>
                  <div class="size-row"><span>S</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'chest', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'length', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'sleeve', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'shoulder', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 's', point: 'opening', unit: 'inches' %}</span></div>
                  <div class="size-row"><span>M</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'chest', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'length', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'sleeve', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'shoulder', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'm', point: 'opening', unit: 'inches' %}</span></div>
                  <div class="size-row"><span>L</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'chest', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'length', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'sleeve', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'shoulder', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'l', point: 'opening', unit: 'inches' %}</span></div>
                  <div class="size-row"><span>XL</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'chest', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'length', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'sleeve', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'shoulder', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: 'tshirt', size: 'xl', point: 'opening', unit: 'inches' %}</span></div>
                </div>
              {% else %}
                <div class="size-guide-table" data-unit="cm">
                  <div class="size-row header">
                    <span>Size</span><span>A</span><span>B</span><span>C</span>
                  </div>
                  <div class="size-row"><span>S</span><span>{% render 'size-measurements', garment: garment_type, size: 's', point: 'a', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 's', point: 'b', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 's', point: 'c', unit: 'cm' %}</span></div>
                  <div class="size-row"><span>M</span><span>{% render 'size-measurements', garment: garment_type, size: 'm', point: 'a', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'm', point: 'b', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'm', point: 'c', unit: 'cm' %}</span></div>
                  <div class="size-row"><span>L</span><span>{% render 'size-measurements', garment: garment_type, size: 'l', point: 'a', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'l', point: 'b', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'l', point: 'c', unit: 'cm' %}</span></div>
                  <div class="size-row"><span>XL</span><span>{% render 'size-measurements', garment: garment_type, size: 'xl', point: 'a', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'xl', point: 'b', unit: 'cm' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'xl', point: 'c', unit: 'cm' %}</span></div>
                </div>
                <div class="size-guide-table" data-unit="inches" style="display:none;">
                  <div class="size-row header">
                    <span>Size</span><span>A</span><span>B</span><span>C</span>
                  </div>
                  <div class="size-row"><span>S</span><span>{% render 'size-measurements', garment: garment_type, size: 's', point: 'a', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 's', point: 'b', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 's', point: 'c', unit: 'inches' %}</span></div>
                  <div class="size-row"><span>M</span><span>{% render 'size-measurements', garment: garment_type, size: 'm', point: 'a', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'm', point: 'b', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'm', point: 'c', unit: 'inches' %}</span></div>
                  <div class="size-row"><span>L</span><span>{% render 'size-measurements', garment: garment_type, size: 'l', point: 'a', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'l', point: 'b', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'l', point: 'c', unit: 'inches' %}</span></div>
                  <div class="size-row"><span>XL</span><span>{% render 'size-measurements', garment: garment_type, size: 'xl', point: 'a', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'xl', point: 'b', unit: 'inches' %}</span><span>{% render 'size-measurements', garment: garment_type, size: 'xl', point: 'c', unit: 'inches' %}</span></div>
                </div>
              {% endif %}
            </div>
            <div class="size-guide-diagram">
              <img src="{{ diagram_file | asset_url }}" alt="{{ garment_name }} Measurement Diagram" width="180" height="180">
            </div>
          </div>
          
          <a href="/pages/size-guide" class="size-guide-link">View Full Size Guide →</a>
        </div>
      </div>
      {% endunless %}
    </div>
  </div>
  
  <!-- Center Column: Fullscreen Images -->
  <div class="product-col-center" id="product-gallery">
    <div class="product-images-fullscreen" id="product-images-fullscreen">
      {% for image in product.images %}
      <div class="fullscreen-image" data-image-index="{{ forloop.index0 }}">
        <img
          src="{{ image | image_url: width: 1600 }}"
          alt="{{ image.alt | escape }}"
          width="800"
          height="1000"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          data-zoom-src="{{ image | image_url: width: 2400 }}"
        >
        {% if product.metafields.custom.model_info != blank %}
          <div class="model-info-overlay">
            {{ product.metafields.custom.model_info | metafield_tag }}
          </div>
        {% endif %}
      </div>
      {% endfor %}
      {% if product.images.size == 0 %}
        <div class="no-image-placeholder">
          <p>No Image Available</p>
        </div>
      {% endif %}
    </div>
    
    {% if product.images.size > 1 %}
    <div class="product-thumbnails-corner">
      {% for image in product.images %}
        <button 
          class="thumbnail{% if forloop.first %} active{% endif %}" 
          data-image-index="{{ forloop.index0 }}"
          type="button"
        >
          <img
            src="{{ image | image_url: width: 100 }}"
            alt="{{ image.alt | escape }}"
            width="60"
            height="75"
            loading="lazy"
          >
        </button>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  
  <!-- Right Column: Options & Add to Cart -->
  <div class="product-col-right">
    {% form 'product', product %}
      {% if bundle_available_for_product %}
        {% render 'drop-bundle-card', context_product: product %}
      {% endif %}

      {% if product.has_only_default_variant == false %}
        <!-- Color Selection (if exists) -->
        {% for option in product.options_with_values %}
          {% assign option_key = option.name | downcase | handleize %}
          {% if option_key contains 'color' or option_key contains 'cor' or option_key contains 'colour' %}
            <div class="product-option-group" data-option-group data-option-name="{{ option.name | escape }}">
              <div class="option-header-inline">
                <span class="option-name">Select Color</span>
                <span class="option-value-display">{{ option.selected_value }}</span>
              </div>
              <div class="color-swatches">
                {% for value in option.values %}
                  {% assign variant_for_color = blank %}
                  {% assign option_index = option.position | minus: 1 %}
                  {% for candidate_variant in product.variants %}
                    {% if candidate_variant.options[option_index] == value %}
                      {% assign variant_for_color = candidate_variant %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% if variant_for_color %}
                    <label class="color-swatch">
                      <input
                        type="radio"
                        name="option-{{ option.position }}"
                        value="{{ value | escape }}"
                        data-option-position="{{ option.position }}"
                        data-option-name="{{ option.name | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      <span class="swatch-image">
                        <img 
                          src="{{ variant_for_color.featured_image | default: product.featured_image | image_url: width: 80 }}" 
                          alt="{{ value }}"
                          width="50"
                          height="65"
                        >
                      </span>
                    </label>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
        
        <!-- Size Selection -->
        {% for option in product.options_with_values %}
          {% assign option_key = option.name | downcase | handleize %}
          {% unless option_key contains 'color' or option_key contains 'cor' or option_key contains 'colour' %}
            <div class="product-option-group" data-option-group data-option-position="{{ option.position }}" data-option-name="{{ option.name | escape }}">
              <label class="option-name">{{ option.name }}</label>
              <div class="size-options">
                {% for value in option.values %}
                  <label class="size-option">
                    <input
                      type="radio"
                      name="option-{{ option.position }}"
                      value="{{ value | escape }}"
                      data-option-position="{{ option.position }}"
                      data-option-name="{{ option.name | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    <span class="size-btn">{{ value }}</span>
                  </label>
                {% endfor %}
              </div>
            </div>
          {% endunless %}
        {% endfor %}
      {% endif %}

      <!-- Hidden variant selector -->
      <select name="id" class="variant-selector" style="display: none;">
        {% for variant in product.variants %}
          <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %}>
            {{ variant.title }}
          </option>
        {% endfor %}
      </select>

      <!-- Variant data for JavaScript -->
      <script type="application/json" id="variant-data">
        {
          "variants": [
            {% for variant in product.variants %}
              {% capture price_html %}{% render 'price', amount: variant.price, product: product %}{% endcapture %}
              {
                "id": {{ variant.id | json }},
                "title": {{ variant.title | json }},
                "available": {{ variant.available | json }},
                "inventory_quantity": {{ variant.inventory_quantity | json }},
                "inventory_policy": {{ variant.inventory_policy | json }},
                "inventory_management": {{ variant.inventory_management | json }},
                "drop_initial_stock": {{ variant.metafields.custom.drop_initial_stock.value | json }},
                "price": {{ variant.price | json }},
                "priceHtml": {{ price_html | json }},
                "option1": {{ variant.option1 | json }},
                "option2": {{ variant.option2 | json }},
                "option3": {{ variant.option3 | json }},
                "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          "options": [
            {% for option in product.options %}
              {
                "name": {{ option | json }},
                "values": {{ option.values | json }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }
      </script>

      <button
        type="submit"
        id="add-to-cart-btn"
        class="add-to-cart-btn"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span class="btn-text">Add to Cart</span>
        <span class="btn-price">{% render 'price', amount: current_variant.price, product: product %}</span>
      </button>

      <p class="stock-status{% unless current_variant.available %} out-stock{% endunless %}" data-stock-status{% if current_variant.available %} hidden{% endif %}></p>
      <p class="product-low-stock" data-low-stock hidden>
        <span class="product-low-stock__live" aria-hidden="true"></span>
        <span>{{ 'drop.low_stock' | t }}</span>
        <span class="visually-hidden">{{ 'drop.low_stock_live' | t }}</span>
      </p>
      <p class="product-extinct" data-extinct hidden>{{ 'drop.extinct' | t }}</p>

      {% if vto_available %}
        <button
          type="button"
          class="btn-try-on-ar"
          data-vto-open
          aria-haspopup="dialog"
          aria-controls="VirtualTryOn-{{ section.id }}"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
            <circle cx="12" cy="13" r="4"/>
          </svg>
          <span>{{ 'products.product.try_on_ar' | t: default: 'Try now using VR' }}</span>
        </button>
      {% endif %}

      {% if settings.enable_drop_features and settings.show_delivery_estimate and product.gift_card? == false %}
        <p
          class="product-delivery-estimate"
          data-delivery-estimate
          data-carrier="{{ settings.shipping_carrier_name | escape }}"
          data-timezone="{{ settings.shipping_timezone | escape }}"
          data-cutoff="{{ settings.shipping_cutoff_time | escape }}"
          data-weekdays="{{ settings.shipping_dispatch_weekdays | escape }}"
          data-closed-dates="{{ settings.shipping_closed_dates | escape }}"
          data-min-days="{{ settings.shipping_min_business_days }}"
          data-max-days="{{ settings.shipping_max_business_days }}"
          data-countdown-template="{{ 'drop.delivery_countdown' | t | escape }}"
          data-after-cutoff-template="{{ 'drop.delivery_after_cutoff' | t | escape }}"
          data-estimate-template="{{ 'drop.delivery_estimate' | t | escape }}"
          role="status"
        ></p>
      {% endif %}

      {% if is_current_drop_product and settings.drop_close_at != blank %}
        <p
          class="product-drop-countdown"
          data-drop-countdown
          data-drop-name="{{ settings.drop_name | escape }}"
          data-end-at="{{ settings.drop_close_at | escape }}"
          data-countdown-template="{{ 'drop.drop_countdown' | t | escape }}"
          data-ended-text="{{ 'drop.drop_ended' | t | escape }}"
          role="status"
        ></p>
      {% endif %}

      {% if is_bundle_product %}
        <p class="product-free-shipping-threshold product-free-shipping-threshold--bundle">{{ 'drop.bundle_free_shipping' | t }}</p>
      {% elsif settings.enable_drop_features and settings.free_shipping_threshold > 0 %}
        {% capture free_shipping_amount %}{{ settings.free_shipping_threshold | times: 100 | money }}{% endcapture %}
        <p class="product-free-shipping-threshold">{{ 'drop.free_shipping_threshold' | t: amount: free_shipping_amount }}</p>
      {% endif %}

      <div class="cart-message" style="display: none;"></div>
    {% endform %}
  </div>
</div>

<!-- Image Lightbox -->
<div class="image-lightbox" id="image-lightbox">
  <button class="lightbox-close" type="button" aria-label="Close">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 6L6 18M6 6l12 12"/>
    </svg>
  </button>
  <div class="lightbox-content">
    <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" id="lightbox-image" width="1200" height="1600">
  </div>
  <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M15 18L9 12L15 6"/>
    </svg>
  </button>
  <button class="lightbox-nav lightbox-next" type="button" aria-label="Next">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 18L15 12L9 6"/>
    </svg>
  </button>
</div>

{% if vto_available %}
  {{ 'virtual-try-on.css' | asset_url | stylesheet_tag }}
  {% render 'virtual-try-on-modal', product: product, section: section, vto_model: vto_model, collection: product.collections.first %}
  <script src="{{ 'virtual-try-on.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% stylesheet %}
  /* Override parent shopify-section grid for product page */
  .shopify-section:has(.product-page-new) {
    --content-margin: 0;
    --page-margin: 0;
    grid-template-columns: 1fr !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }
  
  /* Override main-content gap for product pages */
  .main-content:has(.product-page-new) {
    gap: 0;
  }
  
  /* New Product Page Layout - Full Width */
  .product-page-new {
    grid-column: 1 / -1 !important; /* Override theme's constrained layout */
    display: grid;
    grid-template-columns: 27% 1fr 25%;
    gap: 0;
    min-height: 100vh;
    width: 100%;
    max-width: 100vw;
    margin: 0;
    margin-top: -150px; /* Go behind navbar */
    padding: 0px 25px;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  /* Left Column */
  .product-col-left {
    padding: 240px 30px 25px 30px; /* Extra top padding for navbar */
    z-index: 1;
    background: var(--color-background);
  }
  
  /* Elevate left column when size guide is hovered so popup appears above thumbnails */
  .product-col-left:has(.size-guide-section:hover) {
    z-index: 100;
  }
  
  .product-breadcrumb {
    font-size: 11px;
    color: var(--color-description, #666);
    margin-bottom: 25px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .product-breadcrumb a {
    color: var(--color-description, #666);
    text-decoration: none;
  }
  
  .product-breadcrumb a:hover {
    color: var(--color-foreground);
  }
  
  .product-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 15px;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
  }
  
  .product-title {
    font-size: 18px;
    font-weight: var(--font-heading-weight);
    color: var(--color-title, #000);
    margin: 0;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  
  .product-price {
    font-size: 14px;
    color: var(--color-title, #000);
    white-space: nowrap;
  }
  
  /* Info Sections (Static - no accordion) */
  .product-info-sections {
    margin-top: 0;
  }
  
  .info-section-static {
    margin-bottom: 0;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border);
  }
  
  .info-section-static:last-child {
    border-bottom: none;
  }
  
  .info-section-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-title, #000);
    margin: 0 0 10px 0;
    text-transform: uppercase;
  }
  
  .info-section-body {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-description, #555);
  }
  
  .info-section-body p {
    margin: 0 0 4px 0;
  }
  
  /* Info Links (Shipping Policy, Size Guide) */
  .info-link {
    font-size: 13px;
    color: var(--color-description, #666);
    text-decoration: underline;
    cursor: pointer;
    transition: color 0.2s;
  }
  
  .info-link:hover {
    color: var(--color-foreground);
  }
  
  /* Size Guide Popup on Hover */
  .size-guide-section {
    position: relative;
    display: inline-block;
  }
  
  /* Size Guide Row with Icon */
  .size-guide-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .size-guide-link-text {
    font-size: 13px;
    color: var(--color-description, #666);
    text-decoration: underline;
    cursor: pointer;
    transition: color 0.2s;
  }
  
  .size-guide-link-text:hover {
    color: var(--color-foreground);
  }
  
  .size-guide-info-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .size-guide-close {
    position: absolute;
    top: 10px;
    right: 10px;
    display: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-description, #666);
    transition: color 0.2s;
  }
  
  .size-guide-close:hover {
    color: var(--color-foreground);
  }
  
  .size-guide-popup {
    position: absolute;
    left: 0;
    bottom: 100%;
    margin-bottom: 8px;
    background: var(--color-background, #fff);
    border: 1px solid var(--color-border);
    padding: 15px;
    min-width: 530px;
    max-width: 580px;
    z-index: 999999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px);
    transition: all 0.2s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  
  /* Show popup on hover over info button (desktop) */
  .size-guide-info-btn:hover + .size-guide-popup,
  .size-guide-popup:hover,
  .size-guide-popup.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .size-guide-section:hover {
    position: relative;
    z-index: 999999;
  }
  
  .size-guide-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
  }
  
  .size-guide-popup-title {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .unit-toggle {
    display: flex;
    gap: 4px;
  }
  
  .unit-btn {
    padding: 4px 10px;
    font-size: 10px;
    font-weight: 600;
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .unit-btn.active {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }
  
  /* Size Guide Content with Diagram */
  .size-guide-content {
    display: flex;
    gap: 15px;
    align-items: flex-start;
  }
  
  .size-guide-table-wrapper {
    flex: 1;
    min-width: 0;
  }
  
  .size-guide-diagram {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .size-guide-diagram img {
    max-width: 140px;
    height: auto;
    opacity: 0.9;
  }
  
  .size-guide-link {
    display: block;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
    font-size: 11px;
    text-decoration: none;
    color: var(--color-foreground);
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  
  .size-guide-link:hover {
    opacity: 1;
  }
  
  /* Size Guide Table */
  .size-guide-table {
    margin-top: 0;
    width: 100%;
  }
  
  .size-guide-table .size-row {
    display: grid;
    grid-template-columns: 35px repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 6px 0;
    font-size: 11px;
    border-bottom: 1px solid var(--color-border);
    width: 100%;
    box-sizing: border-box;
  }

  .size-guide-table--5-points .size-row {
    grid-template-columns: 30px repeat(5, minmax(0, 1fr));
    gap: 8px;
    font-size: 10px;
    width: 100%;
    box-sizing: border-box;
  }
  
  .size-guide-table .size-row.header {
    font-weight: 600;
    color: var(--color-title, #000);
    font-size: 10px;
    text-transform: uppercase;
  }
  
  .size-guide-table .size-row:last-child {
    border-bottom: none;
  }
  
  .size-guide-table .size-row span {
    white-space: nowrap;
    text-align: center;
    display: block;
  }

  .size-guide-table .size-row span:first-child {
    text-align: left;
  }
  
  /* Center Column - Fullscreen Images */
  .product-col-center {
    position: relative;
    height: 100vh;
    overflow: hidden;
    margin: 0px 30px;
  }
  
  .product-images-fullscreen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    -webkit-overflow-scrolling: touch; /* Smooth iOS scrolling */
  }
  
  .product-images-fullscreen::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }
  
  .fullscreen-image {
    position: relative;
    height: 100vh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    cursor: zoom-in;
    overflow: hidden;
    transition: opacity 0.3s ease;
  }
  
  .fullscreen-image img {
    width: 100%;

    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .model-info-overlay {
    background-color: rgba(88,88,88,0.22);
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 12px;
    color: #f8f8f8ff;
    font-weight: 400;
    padding: 8px;
    z-index: 5;
    mix-blend-mode: difference;
  }
  
  /* Thumbnails - Vertical Left Side, aligned to bottom */
  .product-thumbnails-corner {
    position: absolute;
    bottom: 30px;
    left: 15px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 10;
  }
  
  .thumbnail {
    width: 50px;
    height: 65px;
    border: 1px solid transparent;
    background: rgba(230, 230, 230, 0.3);
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s;
    opacity: 0.7;
  }
  
  .thumbnail.active {
    border-color: var(--color-primary);
    opacity: 1;
  }
  
  .thumbnail:hover {
    opacity: 1;
  }
  
  .thumbnail img {
    width: 100%;
  }
  
  .no-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 600px;
    background: var(--color-surface);
    color: var(--color-description);
  }
  
  /* Right Column */
  .product-col-right {
    padding: 240px 30px 25px 30px; /* Extra top padding for navbar */
    z-index: 1;
    background: var(--color-background);
  }
  
  .product-option-group {
    margin-bottom: 20px;
  }

  .drop-bundle-card {
    position: relative;
    display: grid;
    grid-template-columns: 148px minmax(0, 1fr);
    gap: 16px;
    margin: 0 0 24px;
    padding: 14px;
    background: var(--color-surface, #111111);
    border: 1px solid var(--color-border, #333333);
    overflow: hidden;
  }

  .drop-bundle-card__offer {
    grid-column: 1 / -1;
    width: 100%;
    margin: 0;
    padding: 8px 12px;
    background: #8f173d;
    color: #ffffff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .1em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  .drop-bundle-card__offer span { margin-right: 3px; color: #f3b15c; }

  .drop-bundle-card__images {
    position: relative;
    min-height: 174px;
    isolation: isolate;
  }

  .drop-bundle-card__images img {
    position: absolute;
    width: 108px;
    height: 148px;
    object-fit: contain;
    background: transparent;
    /* Keep the product cut-outs opaque where they overlap. */
    opacity: 1;
    mix-blend-mode: normal;
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, .12));
  }

  .drop-bundle-card__images img:first-child {
    top: 4px;
    left: 0;
    transform: rotate(-3deg);
    z-index: 1;
  }

  .drop-bundle-card__images img:last-child {
    right: 0;
    bottom: 0;
    transform: rotate(3deg);
    z-index: 2;
  }

  .drop-bundle-card__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .drop-bundle-card__eyebrow,
  .drop-bundle-card__copy,
  .drop-bundle-card__shipping,
  .drop-bundle-card__status {
    margin: 0;
  }

  .drop-bundle-card__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .09em;
  }

  .drop-bundle-card__copy,
  .drop-bundle-card__shipping,
  .drop-bundle-card__status,
  .product-low-stock,
  .product-extinct,
  .product-delivery-estimate,
  .product-drop-countdown,
  .product-free-shipping-threshold {
    font-size: 12px;
    line-height: 1.45;
  }

  .drop-bundle-card__copy { margin-top: 6px; }
  .drop-bundle-card__shipping { margin-top: 8px; font-weight: 700; }

  .drop-bundle-card__sizes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
    margin-top: 12px;
  }

  .drop-bundle-card__sizes label { display: grid; gap: 5px; min-width: 0; font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .drop-bundle-card__sizes select { width: 100%; min-width: 0; min-height: 38px; padding: 7px 24px 7px 9px; border: 1px solid var(--color-border, #333333); border-radius: 0; background: var(--color-background, #fff); color: var(--color-foreground, #111); font: inherit; }

  .drop-bundle-card__button {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    padding: 12px;
    color: var(--color-background);
    background: var(--color-foreground);
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
  }

  .drop-bundle-card__button:disabled {
    cursor: not-allowed;
    opacity: .52;
  }

  .drop-bundle-card__status { margin-top: 8px; color: var(--color-error); }

  .product-low-stock {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 10px;
    color: var(--color-warning, #a16207);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .product-low-stock__live {
    display: inline-block;
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f28c28;
    box-shadow: 0 0 0 3px rgba(242, 140, 40, .18);
  }

  .product-extinct {
    margin: 0 0 14px;
    color: var(--color-error, #b91c1c);
    font-weight: 800;
    letter-spacing: .12em;
  }

  .product-delivery-estimate,
  .product-drop-countdown,
  .product-free-shipping-threshold {
    margin: 14px 0 0;
    color: var(--color-foreground-muted);
  }

  .product-drop-countdown { font-weight: 700; color: var(--color-foreground); }

  .product-drop-countdown.is-ended { color: var(--color-error, #b91c1c); }
  
  .option-header-inline {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  
  .option-name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-title, #000);
    display: block;
    margin-bottom: 12px;
  }
  
  .option-value-display {
    font-size: 14px;
    color: var(--color-description, #666);
  }
  
  /* Color Swatches */
  .color-swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  
  .color-swatch {
    cursor: pointer;
  }
  
  .color-swatch input {
    position: absolute;
    opacity: 0;
  }
  
  .swatch-image {
    display: block;
    width: 50px;
    height: 65px;
    border: 2px solid transparent;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  
  .color-swatch input:checked + .swatch-image {
    border-color: var(--color-foreground);
  }
  
  .swatch-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  /* Size Options */
  .size-options {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  
  .size-option {
    cursor: pointer;
  }
  
  .size-option input {
    position: absolute;
    opacity: 0;
  }
  
  .size-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 50px;
    height: 46px;
    padding: 0 18px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
    background: transparent;
  }
  
  .size-option input:checked + .size-btn {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }
  
  .size-option input:disabled + .size-btn {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .size-option.is-extinct .size-btn,
  .color-swatch.is-extinct .swatch-image {
    opacity: 0.42;
    text-decoration: line-through;
  }

  .size-option.is-extinct .size-btn {
    position: relative;
  }

  .size-option.is-extinct .size-btn::after {
    position: absolute;
    width: calc(100% + 8px);
    height: 1px;
    content: '';
    background: currentColor;
    transform: rotate(-18deg);
  }
  
  /* Stock Status */
  .stock-status {
    font-size: 13px;
    margin: 20px 0;
  }
  
  .stock-status.in-stock {
    color: #22c55e;
  }
  
  .stock-status.out-stock {
    color: var(--color-error);
  }
  
  /* Add to Cart Button */
  .add-to-cart-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 18px 25px;
    background: var(--color-foreground);
    color: var(--color-background);
    border: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  
  .add-to-cart-btn:hover {
    opacity: 0.9;
  }
  
  .add-to-cart-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  
  .cart-message {
    margin-top: 15px;
    padding: 12px;
    text-align: center;
    font-size: 13px;
  }
  
  .cart-message.success {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
  }
  
  .cart-message.error {
    background: rgba(239, 68, 68, 0.1);
    color: var(--color-error);
  }
  
  /* Lightbox */
  .image-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.95);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
  }
  
  .image-lightbox.active {
    display: flex;
  }
  
  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 10px;
  }
  
  .lightbox-content {
    max-width: 90vw;
    max-height: 90vh;
  }
  
  .lightbox-content img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }
  
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 20px;
  }
  
  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }
  
  /* Responsive */
  @media (max-width: 1200px) {
    .product-page-new {
      margin-top: 0;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    
    .product-col-left {
      grid-column: 1;
      grid-row: 2;
      padding: 25px 15px;
    }
    
    .product-col-center {
      grid-column: 1 / -1;
      grid-row: 1;
      height: 70vh;
    }
    
    .fullscreen-image {
      height: 70vh;
    }
    
    .product-col-right {
      grid-column: 2;
      grid-row: 2;
      padding: 25px 15px;
    }
    
    .product-title-row {
      flex-direction: column;
      gap: 5px;
    }
    
    .product-thumbnails-corner {
      bottom: 80px; /* Above model info */
    }
    
    .model-info-overlay {
      bottom: 20px;
    }
  }
  
  @media (max-width: 768px) {
    .product-page-new {
      grid-template-columns: 1fr;
      margin-top: 0;
    }
    
    .product-col-left,
    .product-col-center,
    .product-col-right {
      grid-column: 1;
    }
    
    .product-col-center {
      grid-row: 1;
      height: 75vh;
      margin: 0;
      position: relative;
      overflow: hidden;
    }

    .product-images-fullscreen {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      overscroll-behavior-y: auto;
      touch-action: pan-x pan-y;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .product-images-fullscreen::-webkit-scrollbar {
      display: none;
    }
    
    .fullscreen-image {
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
      max-width: 100%;
      height: 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .fullscreen-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    
    .product-col-left {
      grid-row: 3;
      padding: 20px 20px;
    }
    
    .product-col-right {
      grid-row: 2;
      padding: 20px 20px 96px;
    }

    .drop-bundle-card {
      display: block;
      padding: 14px;
    }

    .drop-bundle-card__images {
      display: none;
    }

    .drop-bundle-card__content {
      margin-top: 11px;
    }

    .drop-bundle-card__sizes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-thumbnails-corner {
      top: auto;
      bottom: 90px; /* Above model info on mobile */
      left: 15px;
      transform: none;
      flex-direction: row;
      gap: 5px;
      max-width: calc(100% - 30px);
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      z-index: 10;
    }

    .product-thumbnails-corner::-webkit-scrollbar {
      display: none;
    }
    
    .model-info-overlay {
      bottom: 15px;
      font-size: 11px;
      padding: 6px;
    }
    
    .thumbnail {
      width: 38px;
      height: 48px;
    }
    
    .size-guide-popup {
      position: fixed;
      left: 14px;
      right: 14px;
      top: auto;
      bottom: 60px;
      max-height: 82vh;
      overflow-y: auto;
      min-width: auto;
      max-width: none;
      opacity: 0;
      visibility: hidden;
      transform: translateY(20px);
      z-index: 999999;
      padding: 16px 14px 18px 14px;
      padding-top: 36px;
      border-radius: 6px;
      box-shadow: 0 10px 32px rgba(0, 0, 0, 0.22);
      border: 1px solid var(--color-border);
      background: var(--color-background, #fff);
      box-sizing: border-box;
    }
    
    .size-guide-popup.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    
    .size-guide-close {
      display: flex;
    }

    .size-guide-content {
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-items: center;
      width: 100%;
    }

    .size-guide-table-wrapper {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
    }

    .size-guide-table {
      width: 100%;
      min-width: 280px;
    }

    .size-guide-table .size-row {
      display: grid;
      grid-template-columns: 32px repeat(3, minmax(55px, 1fr));
      gap: 6px;
      padding: 7px 0;
      font-size: 11px;
      align-items: center;
    }

    .size-guide-table--5-points {
      min-width: 320px;
    }

    .size-guide-table--5-points .size-row {
      display: grid;
      grid-template-columns: 28px repeat(5, minmax(46px, 1fr));
      gap: 4px;
      padding: 7px 0;
      font-size: 10px;
      align-items: center;
    }

    .size-guide-table .size-row span {
      white-space: nowrap;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .size-guide-table .size-row span:first-child {
      text-align: left;
      font-weight: 700;
    }

    .size-guide-table .size-row.header span {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      opacity: 0.85;
    }

    .size-guide-diagram {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 8px 0;
      border-top: 1px dashed var(--color-border);
      margin-top: 2px;
    }

    .size-guide-diagram img {
      max-width: 130px;
      max-height: 110px;
      width: auto;
      height: auto;
      object-fit: contain;
    }

    .size-guide-link {
      margin-top: 8px;
      padding-top: 8px;
      text-align: center;
      font-size: 11px;
    }
    
    /* Disable hover on mobile - use click only */
    .size-guide-info-btn:hover + .size-guide-popup,
    .size-guide-popup:hover {
      opacity: 0;
      visibility: hidden;
    }
    
    .size-guide-popup.active {
      opacity: 1;
      visibility: visible;
    }
    
    .product-title {
      font-size: 16px;
    }
    
    .product-price {
      font-size: 13px;
    }
  }
  
  @media (max-width: 480px) {
    .product-col-center {
      height: 65vh;
    }
    
    .fullscreen-image {
      height: 100%;
    }
    
    .product-col-left,
    .product-col-right {
      padding: 15px;
    }
    
    .product-thumbnails-corner {
      bottom: 75px;
      left: 10px;
      gap: 4px;
    }
    
    .thumbnail {
      width: 32px;
      height: 42px;
    }
    
    .model-info-overlay {
      bottom: 10px;
      font-size: 10px;
    }
  }
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  // Size Guide Popup - Click to toggle on mobile/tablet, hover on desktop
  const sizeGuideInfoBtn = document.querySelector('.size-guide-info-btn');
  const sizeGuidePopup = document.querySelector('.size-guide-popup');
  const sizeGuideClose = document.querySelector('.size-guide-close');
  
  if (sizeGuideInfoBtn && sizeGuidePopup) {
    // Click handler for info button
    sizeGuideInfoBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      sizeGuidePopup.classList.toggle('active');
    });
    
    // Close button handler
    if (sizeGuideClose) {
      sizeGuideClose.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        sizeGuidePopup.classList.remove('active');
      });
    }
    
    // Close popup when clicking outside
    document.addEventListener('click', function(e) {
      if (!sizeGuidePopup.contains(e.target) && !sizeGuideInfoBtn.contains(e.target)) {
        sizeGuidePopup.classList.remove('active');
      }
    });
    
    // Close on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        sizeGuidePopup.classList.remove('active');
      }
    });

    // Unit toggle handler (CM / IN)
    const unitBtns = document.querySelectorAll('.unit-btn');
    unitBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const unit = this.dataset.unit;
        unitBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        const tables = document.querySelectorAll('.size-guide-table');
        tables.forEach(t => {
          if (t.dataset.unit === unit) {
            t.style.display = '';
          } else {
            t.style.display = 'none';
          }
        });
      });
    });
  }

  // Fullscreen image gallery with smooth scroll capture
  const gallery = document.getElementById('product-gallery');
  const imagesContainer = document.getElementById('product-images-fullscreen');
  const thumbnails = document.querySelectorAll('.thumbnail');
  const fullscreenImages = document.querySelectorAll('.fullscreen-image');
  let isGalleryScrolling = true;
  let scrollTimeout = null;
  
  // Smooth scroll to image with easing
  function smoothScrollToImage(targetImage) {
    if (!targetImage || !imagesContainer) return;
    
    if (window.innerWidth <= 768) {
      const targetLeft = targetImage.offsetLeft;
      imagesContainer.scrollTo({
        left: targetLeft,
        behavior: 'smooth'
      });
    } else {
      const targetTop = targetImage.offsetTop;
      imagesContainer.scrollTo({
        top: targetTop,
        behavior: 'smooth'
      });
    }
  }
  
  // Thumbnail click scrolls to image
  thumbnails.forEach(thumb => {
    thumb.addEventListener('click', function() {
      const index = this.dataset.imageIndex;
      const targetImage = document.querySelector(`.fullscreen-image[data-image-index="${index}"]`);
      smoothScrollToImage(targetImage);
    });
  });
  
  // Intersection Observer to update active thumbnail
  if (imagesContainer && fullscreenImages.length > 0) {
    const observerOptions = {
      root: imagesContainer,
      rootMargin: '0px',
      threshold: 0.5
    };
    
    const imageObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const index = entry.target.dataset.imageIndex;
          thumbnails.forEach(t => t.classList.remove('active'));
          const activeThumb = document.querySelector(`.thumbnail[data-image-index="${index}"]`);
          if (activeThumb) {
            activeThumb.classList.add('active');
            if (window.innerWidth <= 768 && activeThumb.scrollIntoView) {
              activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
            }
          }
          
          // Check if we're at the last image on desktop
          if (window.innerWidth > 768) {
            const lastIndex = fullscreenImages.length - 1;
            if (parseInt(index) === lastIndex) {
              // Small delay to allow animation to complete
              clearTimeout(scrollTimeout);
              scrollTimeout = setTimeout(() => {
                const scrolledToBottom = imagesContainer.scrollHeight - imagesContainer.scrollTop <= imagesContainer.clientHeight + 20;
                if (scrolledToBottom) {
                  isGalleryScrolling = false;
                }
              }, 100);
            }
          }
        }
      });
    }, observerOptions);
    
    fullscreenImages.forEach(img => imageObserver.observe(img));
    
    // Capture scroll on gallery until all images viewed - smoother wheel handling
    if (gallery) {
      let accumulatedDelta = 0;
      let lastScrollTime = 0;

      if (window.innerWidth <= 768) {
        isGalleryScrolling = false;
      }
      
      gallery.addEventListener('wheel', function(e) {
        if (window.innerWidth <= 768) return;
        const now = Date.now();
        
        if (isGalleryScrolling) {
          // Check if at the end
          const atBottom = imagesContainer.scrollHeight - imagesContainer.scrollTop <= imagesContainer.clientHeight + 10;
          const atTop = imagesContainer.scrollTop <= 10;
          
          if (e.deltaY > 0 && atBottom) {
            isGalleryScrolling = false;
            return; // Allow page scroll
          }
          if (e.deltaY < 0 && atTop) {
            return; // Allow page scroll up
          }
          
          e.preventDefault();
          
          // Accumulate delta for smoother scrolling
          if (now - lastScrollTime > 50) {
            accumulatedDelta = 0;
          }
          accumulatedDelta += e.deltaY;
          lastScrollTime = now;
          
          // Apply scroll with momentum feel
          imagesContainer.scrollBy({ 
            top: e.deltaY * 1.2, 
            behavior: 'auto' 
          });
        } else {
          // Re-enable gallery scroll if scrolling back up into view
          const rect = gallery.getBoundingClientRect();
          if (rect.top >= -50 && e.deltaY < 0) {
            isGalleryScrolling = true;
            e.preventDefault();
            imagesContainer.scrollTo({
              top: imagesContainer.scrollHeight - imagesContainer.clientHeight,
              behavior: 'auto'
            });
          }
        }
      }, { passive: false });
      
      // Touch support for desktop/tablet vertical capture
      if (window.innerWidth > 768) {
        let touchStartY = 0;
        let touchStartScrollTop = 0;
        
        gallery.addEventListener('touchstart', function(e) {
          touchStartY = e.touches[0].clientY;
          touchStartScrollTop = imagesContainer.scrollTop;
        }, { passive: true });
        
        gallery.addEventListener('touchmove', function(e) {
          if (!isGalleryScrolling) return;

          const touchY = e.touches[0].clientY;
          const deltaY = touchStartY - touchY;

          const atBottom = imagesContainer.scrollHeight - imagesContainer.scrollTop <= imagesContainer.clientHeight + 10;
          const atTop = imagesContainer.scrollTop <= 10;

          if (deltaY > 0 && atBottom) {
            isGalleryScrolling = false;
            return;
          }
          if (deltaY < 0 && atTop) {
            return;
          }
        }, { passive: true });
      }
    }
  }
  
  // Size Guide Unit Toggle
  const unitBtns = document.querySelectorAll('.unit-btn');
  unitBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const unit = this.dataset.unit;
      unitBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      document.querySelectorAll('.size-guide-table').forEach(table => {
        table.style.display = table.dataset.unit === unit ? 'block' : 'none';
      });
    });
  });
  
  // Lightbox
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImage = document.getElementById('lightbox-image');
  const lightboxClose = document.querySelector('.lightbox-close');
  const lightboxPrev = document.querySelector('.lightbox-prev');
  const lightboxNext = document.querySelector('.lightbox-next');
  let currentLightboxIndex = 0;
  
  if (imagesContainer && lightbox) {
    imagesContainer.addEventListener('click', function(e) {
      if (e.target.tagName === 'IMG') {
        const zoomSrc = e.target.dataset.zoomSrc || e.target.src;
        lightboxImage.src = zoomSrc;
        lightboxImage.alt = e.target.alt;
        currentLightboxIndex = parseInt(e.target.closest('.fullscreen-image').dataset.imageIndex);
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
    
    lightboxClose.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) closeLightbox();
    });
    
    function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }
    
    lightboxPrev.addEventListener('click', function() {
      const images = document.querySelectorAll('.fullscreen-image img');
      currentLightboxIndex = (currentLightboxIndex - 1 + images.length) % images.length;
      const img = images[currentLightboxIndex];
      lightboxImage.src = img.dataset.zoomSrc || img.src;
    });
    
    lightboxNext.addEventListener('click', function() {
      const images = document.querySelectorAll('.fullscreen-image img');
      currentLightboxIndex = (currentLightboxIndex + 1) % images.length;
      const img = images[currentLightboxIndex];
      lightboxImage.src = img.dataset.zoomSrc || img.src;
    });
    
    document.addEventListener('keydown', function(e) {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') lightboxPrev.click();
      if (e.key === 'ArrowRight') lightboxNext.click();
    });
  }
  
  // Commerce state: variant availability, drop messages and safe cart adds.
  const commerceRoot = document.querySelector('[data-product-commerce]');
  const variantDataEl = document.getElementById('variant-data');
  if (!commerceRoot || !variantDataEl) return;

  const variantData = JSON.parse(variantDataEl.textContent);
  const productForm = commerceRoot.querySelector('form[action*="/cart/add"]');
  const variantSelector = commerceRoot.querySelector('.variant-selector');
  const priceEl = document.querySelector('.product-price');
  const btnPriceEl = commerceRoot.querySelector('.btn-price');
  const addToCartBtn = commerceRoot.querySelector('#add-to-cart-btn');
  const stockStatus = commerceRoot.querySelector('[data-stock-status]');
  const lowStockEl = commerceRoot.querySelector('[data-low-stock]');
  const extinctEl = commerceRoot.querySelector('[data-extinct]');
  const cartMessage = commerceRoot.querySelector('.cart-message');
  const optionInputs = Array.from(commerceRoot.querySelectorAll('input[data-option-position]'));
  const normalise = (value) => String(value || '').trim().toLocaleLowerCase();
  const optionValue = (variant, position) => variant[`option${position}`];

  function selectedOptions() {
    const values = {};
    optionInputs.filter(input => input.checked).forEach(input => {
      values[Number(input.dataset.optionPosition)] = normalise(input.value);
    });
    return values;
  }

  function matchingVariant(values) {
    return variantData.variants.find(variant => Object.entries(values).every(([position, value]) => normalise(optionValue(variant, position)) === value));
  }

  function isControlAvailable(input, values) {
    const position = Number(input.dataset.optionPosition);
    const proposed = { ...values, [position]: normalise(input.value) };
    return variantData.variants.some(variant => variant.available && Object.entries(proposed).every(([key, value]) => normalise(optionValue(variant, key)) === value));
  }

  function isSizeInput(input) {
    return /size|tamanho/i.test(input.dataset.optionName || '');
  }

  function setMessage(element, message, visible, className) {
    if (!element) return;
    if (message !== undefined) element.textContent = message;
    element.hidden = !visible;
    if (className) element.className = className;
  }

  function updateVariant() {
    const values = selectedOptions();
    const variant = matchingVariant(values);
    optionInputs.forEach(input => {
      const available = isControlAvailable(input, values);
      input.disabled = !available && !input.checked && !isSizeInput(input);
      input.closest('label')?.classList.toggle('is-extinct', !available);
      input.closest('label')?.setAttribute('aria-disabled', String(!available));
    });

    if (!variant) {
      if (variantSelector) variantSelector.value = '';
      if (addToCartBtn) addToCartBtn.disabled = true;
      setMessage(stockStatus, window.themeStrings?.sold_out || 'Sold out', true, 'stock-status out-stock');
      setMessage(extinctEl, undefined, false);
      setMessage(lowStockEl, undefined, false);
      return;
    }

    if (variantSelector) variantSelector.value = variant.id;
    if (priceEl) priceEl.innerHTML = variant.priceHtml;
    if (btnPriceEl) btnPriceEl.innerHTML = variant.priceHtml;
    if (addToCartBtn) {
      addToCartBtn.disabled = !variant.available;
      const text = addToCartBtn.querySelector('.btn-text');
      if (text) text.textContent = variant.available ? (window.themeStrings?.add_to_cart || 'Add to Cart') : (window.themeStrings?.sold_out || 'Sold out');
    }

    const selectedSizeOutOfStock = optionInputs.some(input => input.checked && isSizeInput(input)) && !variant.available;
    setMessage(stockStatus, window.themeStrings?.sold_out || 'Sold out', !variant.available && !selectedSizeOutOfStock, 'stock-status out-stock');
    setMessage(extinctEl, undefined, selectedSizeOutOfStock);
    const initialStock = Number(variant.drop_initial_stock);
    const ratioLimit = Number(commerceRoot.dataset.lowStockRatio || 67) / 100;
    const isLowStock = commerceRoot.dataset.lowStockEnabled === 'true'
      && variant.available
      && variant.inventory_management === 'shopify'
      && variant.inventory_policy === 'deny'
      && Number.isFinite(initialStock)
      && initialStock > 0
      && Number(variant.inventory_quantity) > 0
      && Number(variant.inventory_quantity) / initialStock <= ratioLimit;
    setMessage(lowStockEl, undefined, isLowStock);
  }

  optionInputs.forEach(input => input.addEventListener('change', updateVariant));
  updateVariant();

  function showCartMessage(message, isError) {
    if (!cartMessage) return;
    cartMessage.className = `cart-message ${isError ? 'error' : 'success'}`;
    cartMessage.textContent = message;
    cartMessage.style.display = 'block';
  }

  if (productForm) {
    productForm.addEventListener('submit', async event => {
      event.preventDefault();
      if (!variantSelector?.value || !addToCartBtn || addToCartBtn.disabled) return;
      const buttonText = addToCartBtn.querySelector('.btn-text');
      const previousText = buttonText?.textContent;
      addToCartBtn.disabled = true;
      if (buttonText) buttonText.textContent = window.themeStrings?.adding || 'Adding...';
      try {
        const formData = new FormData(productForm);
        if (!window.addToCartAndUpdate) throw new Error('Cart service unavailable');
        await window.addToCartAndUpdate(formData, 'product');
        showCartMessage(window.themeStrings?.added_to_cart || 'Added to cart!', false);
      } catch (error) {
        showCartMessage(error.added ? (window.themeStrings?.cart_refresh_failed || error.message) : (error.message || window.themeStrings?.error_adding_to_cart || 'Error adding to cart.'), true);
      } finally {
        updateVariant();
        if (buttonText && !addToCartBtn.disabled) buttonText.textContent = previousText || window.themeStrings?.add_to_cart || 'Add to Cart';
      }
    });
  }

  function zonedParts(timeZone) {
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    return Object.fromEntries(parts.filter(part => part.type !== 'literal').map(part => [part.type, Number(part.value)]));
  }

  function initialiseDeliveryEstimate() {
    const estimate = commerceRoot.querySelector('[data-delivery-estimate]');
    if (!estimate) return;
    const weekdays = new Set((estimate.dataset.weekdays || '1,2,3,4,5').split(',').map(Number));
    const closedDates = new Set((estimate.dataset.closedDates || '').split(/[\n,]+/).map(value => value.trim()).filter(Boolean));
    const [cutoffHour, cutoffMinute] = (estimate.dataset.cutoff || '15:00').split(':').map(Number);
    const timeZone = estimate.dataset.timezone || 'Europe/Lisbon';
    const isBusinessDay = date => weekdays.has(((date.getUTCDay() + 6) % 7) + 1) && !closedDates.has(date.toISOString().slice(0, 10));
    const nextBusinessDate = (date, offset = 0) => {
      const result = new Date(date);
      result.setUTCDate(result.getUTCDate() + offset);
      while (!isBusinessDay(result)) result.setUTCDate(result.getUTCDate() + 1);
      return result;
    };
    const displayDate = date => new Intl.DateTimeFormat(document.documentElement.lang || undefined, { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' }).format(date);
    const render = () => {
      try {
        const now = zonedParts(timeZone);
        const base = new Date(Date.UTC(now.year, now.month - 1, now.day));
        const secondsUntilCutoff = (cutoffHour * 3600 + cutoffMinute * 60) - (now.hour * 3600 + now.minute * 60 + now.second);
        const beforeCutoff = secondsUntilCutoff > 0;
        const dispatch = nextBusinessDate(base, beforeCutoff ? 0 : 1);
        const from = nextBusinessDate(dispatch, Number(estimate.dataset.minDays || 1));
        const to = nextBusinessDate(dispatch, Number(estimate.dataset.maxDays || 3));
        const totalMinutes = Math.ceil(Math.max(0, secondsUntilCutoff) / 60);
        const time = `${Math.floor(totalMinutes / 60)}h ${totalMinutes % 60}m`;
        const countdown = beforeCutoff
          ? estimate.dataset.countdownTemplate.replace('___TIME___', time).replace('___DAY___', displayDate(dispatch))
          : estimate.dataset.afterCutoffTemplate.replace('___DAY___', displayDate(dispatch));
        const arrival = estimate.dataset.estimateTemplate.replace('___CARRIER___', estimate.dataset.carrier).replace('___FROM___', displayDate(from)).replace('___TO___', displayDate(to));
        estimate.textContent = `${countdown} ${arrival}`;
      } catch (_) {
        estimate.hidden = true;
      }
    };
    render();
    window.setInterval(render, 60000);
  }

  function initialiseDropCountdown() {
    const countdown = commerceRoot.querySelector('[data-drop-countdown]');
    if (!countdown) return;
    const endAt = Date.parse(countdown.dataset.endAt);
    if (Number.isNaN(endAt)) { countdown.hidden = true; return; }
    const render = () => {
      const remaining = Math.max(0, endAt - Date.now());
      if (remaining === 0) {
        countdown.textContent = countdown.dataset.endedText;
        countdown.classList.add('is-ended');
        return;
      }
      const totalMinutes = Math.floor(remaining / 60000);
      const days = Math.floor(totalMinutes / 1440);
      const hours = Math.floor((totalMinutes % 1440) / 60);
      const minutes = totalMinutes % 60;
      countdown.textContent = countdown.dataset.countdownTemplate.replace('___DROP___', countdown.dataset.dropName).replace('___DAYS___', days).replace('___HOURS___', hours).replace('___MINUTES___', minutes);
    };
    render();
    window.setInterval(render, 60000);
  }

  initialiseDeliveryEstimate();
  initialiseDropCountdown();
});
{% endjavascript %}

