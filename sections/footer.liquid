<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.3.2/css/flag-icons.min.css">

<footer class="site-footer full-width">
  <div class="footer-container">
    <!-- Newsletter Section -->
    <div class="footer-newsletter-section">
      <h3 class="footer-newsletter-title">Newsletter</h3>
      <p class="footer-newsletter-subtitle">Receive curiosities, stories, collection news and events.</p>
      {% form 'customer', id: 'FooterNewsletterForm', class: 'footer-newsletter-form', onsubmit: 'window.loadingScreen.show();' %}
        <input type="hidden" name="contact[tags]" value="newsletter_footer">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        {%- if form.posted_successfully? -%}
          <p class="newsletter-form__message newsletter-form__message--success">
            Thank you for subscribing. Welcome to Incorrect Society.
          </p>
          <script>try { localStorage.setItem('newsletter_modal_status', 'subscribed'); } catch(e){}</script>
        {%- else -%}
          <div class="footer-newsletter-input-wrapper">
            <input type="email" name="contact[email]" placeholder="Enter your email address" required class="footer-newsletter-input">
            <button type="submit" class="footer-newsletter-submit" aria-label="Subscribe">→</button>
          </div>
          {%- if form.errors -%}
            <div class="newsletter-form__message newsletter-form__message--error">
              {%- capture error_messages -%}{{ form.errors | default_errors }}{%- endcapture -%}
              {%- if error_messages contains 'taken' or error_messages contains 'already' -%}
                This email is already subscribed to our newsletter.
              {%- else -%}
                {{ error_messages }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {% endform %}
      <a href="{{ pages['newsletter'].url }}" class="footer-signup-link">
        <span class="arrow">→</span> Sign up for curiosities and updates
      </a>
    </div>

    <!-- Footer Links Columns -->
    <div class="footer-links-columns">
      <!-- Contact Us -->
      <div class="footer-column">
        <h4 class="footer-column-title">Contact us</h4>
        <ul class="footer-column-links">
          <li><a href="{{ pages['contact-us'].url }}">Contact</a></li>
        </ul>
      </div>

      <!-- Client Services -->
      <div class="footer-column">
        <h4 class="footer-column-title">Client Services</h4>
        <ul class="footer-column-links">
          <li><a href="{{ pages['return-policy'].url }}">Make a return</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div class="footer-column">
        <h4 class="footer-column-title">Company</h4>
        <ul class="footer-column-links">
          <li><a href="{{ pages['return-policy'].url }}">Returns & exchanges</a></li>
          <li><a href="{{ pages['shipping-policy'].url }}">Shipping policy</a></li>
          <li><a href="{{ pages['terms-of-service'].url }}">Terms & conditions</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div class="footer-column">
        <h4 class="footer-column-title">Social</h4>
        <ul class="footer-column-links">
          <li><a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="{{ settings.tiktok_url }}" target="_blank" rel="noopener">Tiktok</a></li>
          <li><a href="{{ settings.youtube_url }}" target="_blank" rel="noopener">Youtube</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="footer-bottom-content">
      {% if localization.available_countries.size > 1 %}
        {% assign localization_form_id = 'FooterLocalizationForm-' | append: section.id %}
        <div class="footer-localization" data-footer-localization>
          {% form 'localization', id: localization_form_id, class: 'footer-localization__form' %}
            <input type="hidden" name="return_to" value="{{ request.path | escape }}">
            <input type="hidden" name="country_code" value="{{ localization.country.iso_code | escape }}" data-country-input>
            <span class="footer-localization__eyebrow">{{ 'localization.country_region' | t }}</span>
            <button
              type="button"
              class="footer-localization__trigger"
              data-country-trigger
              aria-expanded="false"
              aria-haspopup="listbox"
              aria-controls="FooterCountryList-{{ section.id }}"
              aria-label="{{ 'localization.country_region' | t | escape }}: {{ localization.country.name | escape }}"
            >
              <span class="footer-localization__flag fi fi-{{ localization.country.iso_code | downcase }}" data-current-flag aria-hidden="true"></span>
              <span class="footer-localization__current" data-current-country>
                {{ localization.country.name | escape }} · {{ localization.country.currency.iso_code | escape }}
              </span>
              <svg class="footer-localization__chevron" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
            <div id="FooterCountryList-{{ section.id }}" class="footer-localization__menu" data-country-menu role="listbox" hidden>
              {% for country in localization.available_countries %}
                <button
                  type="button"
                  class="footer-localization__option"
                  data-country-option
                  data-country-code="{{ country.iso_code | escape }}"
                  data-country-name="{{ country.name | escape }}"
                  data-country-currency="{{ country.currency.iso_code | escape }}"
                  role="option"
                  aria-selected="{% if country.iso_code == localization.country.iso_code %}true{% else %}false{% endif %}"
                >
                  <span class="footer-localization__flag fi fi-{{ country.iso_code | downcase }}" aria-hidden="true"></span>
                  <span>{{ country.name | escape }}</span>
                  <span class="footer-localization__currency">{{ country.currency.iso_code | escape }} {{ country.currency.symbol | escape }}</span>
                </button>
              {% endfor %}
            </div>
          {% endform %}
        </div>
      {% endif %}
      <div class="footer-brand-lockup">
        <span class="footer-brand-name">{{ shop.name | upcase }} ®</span>
        <span class="footer-copyright">NOT IN ACCORDANCE WITH ANY STANDARD OR RULE</span>
      </div>
      <img src="https://cdn.shopify.com/s/files/1/0954/9840/4181/files/Logo_black.svg?v=1764257555" alt="{{ shop.name }}" class="footer-logo" width="80" height="40">
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    margin-top: auto;
    background-color: var(--color-surface);
    padding-top: 60px;
    width: 100%;
  }

  /* Make footer full width */
  .shopify-section:has(.site-footer) {
    grid-column: 1 / -1;
    max-width: none;
  }

  .footer-container {
    width: 100%;
    max-width: none;
    margin: 0 auto;
    padding: 0 60px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
  }

  /* Newsletter Section */
  .footer-newsletter-section {
    max-width: 400px;
  }

  .footer-newsletter-title {
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: var(--font-heading-weight);
    margin: 0 0 8px 0;
    color: var(--color-foreground);
  }

  .footer-newsletter-subtitle {
    font-size: 13px;
    color: var(--color-foreground);
    opacity: 0.7;
    margin: 0 0 24px 0;
    line-height: 1.5;
  }

  .footer-newsletter-form {
    margin-bottom: 20px;
  }

  .footer-newsletter-input-wrapper {
    position: relative;
    display: flex;
  }

  .footer-newsletter-input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    font-family: var(--font-primary-family);
    font-size: 13px;
    color: var(--color-foreground);
  }

  .footer-newsletter-input::placeholder {
    color: var(--color-foreground);
    opacity: 0.5;
  }

  .footer-newsletter-submit {
    background-color: var(--color-foreground);
    color: var(--color-background);
    border: 1px solid var(--color-border);
    border-left: none;
    padding: 0 16px;
    font-size: 18px;
    cursor: pointer;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .footer-newsletter-submit:hover {
    opacity: 0.8;
  }

  .newsletter-form__message--success {
    color: var(--color-foreground);
    font-size: 13px;
    margin: 0;
    line-height: 1.5;
  }

  .newsletter-form__message--error {
    color: #d93025;
    font-size: 12px;
    margin-top: 8px;
    line-height: 1.5;
  }

  .footer-signup-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-foreground);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer-signup-link:hover {
    opacity: 0.7;
  }

  .footer-signup-link .arrow {
    font-size: 14px;
  }

  /* Footer Links Columns */
  .footer-links-columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }

  .footer-column-title {
    font-family: var(--font-heading-family);
    font-size: 14px;
    font-weight: var(--font-heading-weight);
    margin: 0 0 20px 0;
    color: var(--color-foreground);
  }

  .footer-column-title sup {
    font-size: 10px;
    opacity: 0.5;
    margin-left: 2px;
  }

  .footer-column-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-column-links a {
    font-size: 13px;
    color: var(--color-foreground);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .footer-column-links a:hover {
    opacity: 1;
  }

  /* Footer Bottom */
  .footer-bottom {
    margin-top: 20px;
    padding: 28px 40px;
    border-top: 1px solid var(--color-border);
  }

  .footer-bottom-content {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(280px, 1.35fr) minmax(220px, 1fr);
    align-items: center;
    gap: 32px;
  }

  .footer-localization {
    justify-self: start;
    position: relative;
    z-index: 2;
  }

  .footer-brand-lockup {
    display: grid;
    justify-items: center;
    gap: 5px;
    padding: 0 24px;
    text-align: center;
  }

  .footer-brand-name {
    color: var(--color-foreground);
    font-size: 10px;
    letter-spacing: 0.13em;
    line-height: 1.25;
  }

  .footer-localization__form {
    position: relative;
  }

  .footer-localization__eyebrow {
    display: block;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 7px 2px;
    color: var(--color-foreground-muted);
  }

  .footer-localization__trigger {
    align-items: center;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
    display: flex;
    font: inherit;
    font-size: 12px;
    gap: 9px;
    justify-content: space-between;
    min-height: 42px;
    min-width: 224px;
    padding: 0 12px;
    text-align: left;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .footer-localization__trigger:hover,
  .footer-localization__trigger[aria-expanded='true'] {
    border-color: var(--color-foreground);
  }

  .footer-localization__flag {
    flex: 0 0 22px;
    height: 16px;
    width: 22px;
  }

  .footer-localization__current {
    flex: 1;
    letter-spacing: 0.02em;
  }

  .footer-localization__chevron {
    flex: 0 0 12px;
    height: 8px;
    transition: transform 160ms ease;
    width: 12px;
  }

  .footer-localization__trigger[aria-expanded='true'] .footer-localization__chevron {
    transform: rotate(180deg);
  }

  .footer-localization__menu {
    background: var(--color-background);
    border: 1px solid var(--color-foreground);
    bottom: calc(100% + 8px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.12);
    left: 0;
    max-height: min(300px, 52vh);
    min-width: 280px;
    overflow-y: auto;
    padding: 5px;
    position: absolute;
    width: max-content;
  }

  .footer-localization__option {
    align-items: center;
    background: transparent;
    border: 0;
    color: var(--color-foreground);
    cursor: pointer;
    display: grid;
    font: inherit;
    font-size: 12px;
    gap: 10px;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    min-height: 42px;
    padding: 0 9px;
    text-align: left;
    width: 100%;
  }

  .footer-localization__option:hover,
  .footer-localization__option:focus-visible,
  .footer-localization__option[aria-selected='true'] {
    background: var(--color-surface);
  }

  .footer-localization__currency {
    color: var(--color-foreground-muted);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .footer-localization__trigger:focus-visible,
  .footer-localization__option:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .footer-copyright {
    max-width: 360px;
    font-size: 9px;
    letter-spacing: 0.11em;
    line-height: 1.45;
    color: var(--color-foreground);
    opacity: 0.6;
    text-align: center;
  }

  .footer-logo {
    justify-self: end;
    height: 40px;
    width: auto;
    opacity: 0.8;
  }

  body.footer-bottom-is-visible .secure-scratch__teaser,
  body.footer-bottom-is-visible .footer-music-player-wrapper {
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .footer-newsletter-section {
      max-width: 100%;
    }

    .footer-links-columns {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .footer-bottom-content {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 20px;
    }

    .footer-brand-lockup {
      grid-column: 1 / -1;
      grid-row: 2;
      padding: 0;
    }

    .footer-logo {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 640px) {
    .footer-container {
      padding: 0 20px;
    }

    .footer-links-columns {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .footer-bottom {
      padding: 24px 20px 28px;
    }

    .footer-bottom-content {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      text-align: center;
    }

    .footer-localization {
      justify-self: stretch;
      order: 1;
    }

    .footer-brand-lockup {
      grid-column: auto;
      grid-row: auto;
      order: 2;
      padding: 0;
    }

    .footer-logo {
      grid-column: auto;
      grid-row: auto;
      order: 3;
      justify-self: center;
    }

    .footer-localization__form {
      margin: 0 auto;
      max-width: 360px;
    }

    .footer-localization__trigger {
      min-width: 0;
      width: 100%;
    }

    .footer-localization__menu {
      min-width: 100%;
      width: 100%;
    }

    .footer-music-player-wrapper {
      bottom: calc(15px + env(safe-area-inset-bottom, 0px));
      right: 15px;
      padding: 6px 10px;
    }

    .footer-music-player-wrapper .cd-music-player-minimal {
      gap: 12px;
    }

    .footer-music-player-wrapper .cd-cover-minimal {
      width: 50px;
      height: 50px;
    }

    .footer-music-player-wrapper .cd-play-btn-minimal svg {
      width: 32px;
      height: 32px;
    }
  }

  /* Music Player - Fixed position */
  .footer-music-player-wrapper {
    position: fixed;
    bottom: calc(30px + env(safe-area-inset-bottom, 0px));
    right: 30px;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 50px;
    padding: 8px 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .footer-music-player-wrapper:hover {
    background: rgba(0, 0, 0, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.4);
  }

  .footer-music-player-wrapper .cd-music-player-minimal {
    margin: 0;
  }

  @media (max-width: 749px) {
    .footer-music-player-wrapper {
      bottom: calc(15px + env(safe-area-inset-bottom, 0px));
      right: 15px;
      padding: 6px 10px;
    }
  }
{% endstylesheet %}

<!-- Music Player - Fixed Bottom Right -->
<div class="footer-music-player-wrapper">
  {% render 'music-player' %}
</div>

<script>
  (function () {
    function initFooterLocalization(root) {
      (root || document).querySelectorAll('[data-footer-localization]').forEach(function (container) {
        if (container.dataset.localizationBound === 'true') return;
        var form = container.querySelector('form');
        var input = container.querySelector('[data-country-input]');
        var trigger = container.querySelector('[data-country-trigger]');
        var menu = container.querySelector('[data-country-menu]');
        var currentFlag = container.querySelector('[data-current-flag]');
        var currentCountry = container.querySelector('[data-current-country]');
        var options = Array.prototype.slice.call(container.querySelectorAll('[data-country-option]'));
        if (!form || !input || !trigger || !menu || !options.length) return;

        container.dataset.localizationBound = 'true';
        function closeMenu(restoreFocus) {
          menu.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
          if (restoreFocus) trigger.focus();
        }

        function openMenu() {
          menu.hidden = false;
          trigger.setAttribute('aria-expanded', 'true');
        }

        trigger.addEventListener('click', function () {
          if (menu.hidden) {
            openMenu();
          } else {
            closeMenu(false);
          }
        });

        trigger.addEventListener('keydown', function (event) {
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
          event.preventDefault();
          openMenu();
          var selected = options.find(function (option) { return option.getAttribute('aria-selected') === 'true'; });
          (selected || options[0]).focus();
        });

        options.forEach(function (option) {
          option.addEventListener('click', function () {
            var countryCode = option.dataset.countryCode;
            if (!countryCode || countryCode === input.value) {
              closeMenu(false);
              return;
            }
            input.value = countryCode;
            options.forEach(function (item) {
              item.setAttribute('aria-selected', item === option ? 'true' : 'false');
            });
            if (currentFlag) currentFlag.className = 'footer-localization__flag fi fi-' + countryCode.toLowerCase();
            if (currentCountry) currentCountry.textContent = `${option.dataset.countryName} · ${option.dataset.countryCurrency}`;
            form.submit();
          });
        });

        container.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && !menu.hidden) {
            event.preventDefault();
            closeMenu(true);
          }
        });

        document.addEventListener('pointerdown', function (event) {
          if (!container.contains(event.target) && !menu.hidden) closeMenu(false);
        });
      });
    }

    function initFooterDocking(root) {
      var footerBottom = (root || document).querySelector('.footer-bottom');
      if (!footerBottom || footerBottom.dataset.dockingBound === 'true') return;
      footerBottom.dataset.dockingBound = 'true';

      function setFloatingControlsVisibility(isFooterVisible) {
        document.body.classList.toggle('footer-bottom-is-visible', isFooterVisible);
      }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          setFloatingControlsVisibility(entries[0].isIntersecting);
        }, { threshold: 0.05 }).observe(footerBottom);
        return;
      }

      function updateFloatingControlsVisibility() {
        var bounds = footerBottom.getBoundingClientRect();
        setFloatingControlsVisibility(bounds.top < window.innerHeight && bounds.bottom > 0);
      }

      updateFloatingControlsVisibility();
      window.addEventListener('scroll', updateFloatingControlsVisibility, { passive: true });
      window.addEventListener('resize', updateFloatingControlsVisibility);
    }

    initFooterLocalization(document);
    initFooterDocking(document);
    document.addEventListener('shopify:section:load', function (event) {
      initFooterLocalization(event.target);
      initFooterDocking(event.target);
    });
  })();
</script>

