<div class="announcement-bar">
  {% liquid
    assign msg1 = section.settings.message_1 | default: settings.announcement_message_1 | strip
    assign msg2 = section.settings.message_2 | default: settings.announcement_message_2 | strip
    assign msg3 = section.settings.message_3 | default: settings.announcement_message_3 | strip

    assign scroll_duration = section.settings.scroll_speed | default: 35
  %}

  {% capture brand_icon %}
    {% if section.settings.custom_icon != blank %}
      {{ section.settings.custom_icon | image_url: width: 60 | image_tag: class: 'announcement-icon', alt: '', width: 26, height: 26, loading: 'eager' }}
    {% else %}
      <img
        src="https://cdn.shopify.com/s/files/1/0954/9840/4181/files/Logo_white.svg?v=1764257556"
        class="announcement-icon"
        alt=""
        width="26"
        height="26"
        loading="eager"
      >
    {% endif %}
  {% endcapture %}

  {% capture announcement_unit %}
    {% if msg1 != blank %}
      <span class="announcement-item">
        <span class="announcement-icon-wrap" aria-hidden="true">
          {{ brand_icon }}
        </span>
        <span class="announcement-copy">{{ msg1 | escape }}</span>
      </span>
    {% endif %}
    {% if msg2 != blank %}
      <span class="announcement-item">
        <span class="announcement-icon-wrap" aria-hidden="true">
          {{ brand_icon }}
        </span>
        <span class="announcement-copy">{{ msg2 | escape }}</span>
      </span>
    {% endif %}
    {% if msg3 != blank %}
      <span class="announcement-item">
        <span class="announcement-icon-wrap" aria-hidden="true">
          {{ brand_icon }}
        </span>
        <span class="announcement-copy">{{ msg3 | escape }}</span>
      </span>
    {% endif %}
  {% endcapture %}

  {% capture announcement_track_content %}
    {{ announcement_unit }}
    {{ announcement_unit }}
    {{ announcement_unit }}
    {{ announcement_unit }}
  {% endcapture %}

  <div
    class="announcement-content"
    style="--announcement-duration: {{ scroll_duration }}s;"
    aria-label="{{ 'announcement.aria_label' | t | default: 'Store announcement' }}"
  >
    <div class="announcement-track">
      {{ announcement_track_content }}
    </div>
    <div class="announcement-track" aria-hidden="true">
      {{ announcement_track_content }}
    </div>
  </div>
</div>

{% stylesheet %}
  .announcement-bar {
    background-color: var(--color-primary);
    color: #ffffff;
    height: 30px;
    overflow: hidden;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    z-index: 1000;
  }

  .announcement-content {
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    animation: announcement-scroll var(--announcement-duration, 35s) linear infinite;
    line-height: 30px;
    font-weight: var(--font-heading-weight);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: var(--font-heading-letter-spacing);
    width: max-content;
    text-rendering: geometricPrecision;
    will-change: transform;
  }

  .announcement-track {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .announcement-item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .announcement-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
  }

  .announcement-icon {
    width: 26px;
    height: 26px;
    object-fit: contain;
    display: block;
  }

  .announcement-copy {
    display: inline-block;
    color: #ffffff;
    white-space: nowrap;
  }

  @keyframes announcement-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-content {
      animation: none;
      position: relative;
      overflow-x: auto;
      width: 100%;
      justify-content: center;
    }
    .announcement-track[aria-hidden="true"] {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll duration",
      "default": 35
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom separator icon"
    }
  ]
}
{% endschema %}
