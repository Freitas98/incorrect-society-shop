<div class="announcement-bar">
  {% liquid
    assign default_text = 'announcement.default' | t | default: 'WORLDWIDE SHIPPING | FEMALE ANXIETY OUT NOW | FREE SHIPPING 80€+'
    assign setting_text = section.settings.announcement_text | strip
    assign announcement_text = default_text
    if section.settings.use_translated_default == false and setting_text != blank
      assign announcement_text = setting_text
    endif
    assign no_restock_text = ''
    if settings.enable_drop_features and settings.drop_show_no_restock
      assign no_restock_text = 'drop.no_restocks' | t
    endif
    assign extra_messages = section.settings.announcement_extra_messages | newline_to_br | split: '<br />'
  %}
  {% capture announcement_sequence %}
    <img src="https://cdn.shopify.com/s/files/1/0954/9840/4181/files/Logo_white.svg?v=1764257556" class="announcement-icon" alt="" width="60" height="60">
    {% assign primary_messages = announcement_text | split: '|' %}
    {% for primary_message in primary_messages %}
      {% assign primary_message = primary_message | strip %}
      {% if primary_message != blank %}
        <span class="announcement-message">
          <span class="announcement-copy">{{ primary_message | escape }}</span>
          <img src="https://cdn.shopify.com/s/files/1/0954/9840/4181/files/Logo_white.svg?v=1764257556" class="announcement-icon" alt="" width="60" height="60">
        </span>
      {% endif %}
    {% endfor %}
    {% for extra_message in extra_messages %}
      {% assign extra_message = extra_message | strip %}
      {% if extra_message != blank %}
        <span class="announcement-message">
          <span class="announcement-copy">{{ extra_message | escape }}</span>
          <img src="https://cdn.shopify.com/s/files/1/0954/9840/4181/files/Logo_white.svg?v=1764257556" class="announcement-icon" alt="" width="60" height="60">
        </span>
      {% endif %}
    {% endfor %}
    {% if no_restock_text != blank %}
      <span class="announcement-message">
        <span class="announcement-copy announcement-copy--no-restocks">{{ no_restock_text }}</span>
      <img src="https://cdn.shopify.com/s/files/1/0954/9840/4181/files/Logo_white.svg?v=1764257556" class="announcement-icon" alt="" width="60" height="60">
      </span>
    {% endif %}
  {% endcapture %}
  <div class="announcement-content" aria-label="{{ 'announcement.aria_label' | t | default: 'Store announcement' }}">
    <div class="announcement-track">
      {{ announcement_sequence }}
    </div>
    <div class="announcement-track" aria-hidden="true">
      {{ announcement_sequence }}
    </div>
  </div>
</div>

{% stylesheet %}
  .announcement-bar {
    background-color: var(--color-primary);
    color: #ffffff;
    height: 30px;
    overflow: hidden;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    z-index: 1000;
  }

  .announcement-content {
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    animation: announcement-scroll 28s linear infinite;
    line-height: 30px;
    font-weight: var(--font-heading-weight);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: var(--font-heading-letter-spacing);
    width: max-content;
    text-rendering: geometricPrecision;
    will-change: transform;
  }

  .announcement-track {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .announcement-message {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: white;
    margin-right: 13px;
  }

  .announcement-icon {
    width: 26px;
    height: 26px;
    object-fit: contain;
    display: inline-block;
  }

  .announcement-copy--no-restocks {
    font-weight: 700;
  }

  @keyframes announcement-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-content {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_translated_default",
      "label": "Use translated default",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Main messages",
      "info": "Use | to separate messages.",
      "default": " WORLDWIDE SHIPPING | FEMALE ANXIETY OUT NOW | FREE SHIPPING 80€+ IN PORTUGAL"
    },
    {
      "type": "textarea",
      "id": "announcement_extra_messages",
      "label": "Additional rotating messages",
      "info": "One message per line. Blank lines are ignored."
    }
  ]
}
{% endschema %}
