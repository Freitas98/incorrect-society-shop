{% schema %}
{
  "name": "Editorial Hero Banner",
  "tag": "section",
  "class": "hero-editorial-section",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Banner Height",
      "options": [
        { "value": "full", "label": "Full Screen (100vh)" },
        { "value": "large", "label": "Full Screen (100vh)" },
        { "value": "medium", "label": "Medium (75vh)" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Focus / Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "left center", "label": "Left (models on left)" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top Center" }
      ],
      "default": "left center"
    },
    {
      "type": "header",
      "content": "Content & Typography"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Eyebrow / Sub-tag",
      "default": "SECRETS & SINS • DROP 01"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main Headline",
      "default": "NOT MADE\nFOR EVERYONE",
      "info": "Use line breaks to stack words for high visual impact"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Editorial Paragraph",
      "default": "A collection built on unfiltered expression. Heavyweight 280gsm cotton, relaxed boxy silhouettes, and distinct graphics made to outlast every trend. Secrets kept, sins committed."
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position (Desktop)",
      "options": [
        { "value": "right", "label": "Right Side" },
        { "value": "left", "label": "Left Side" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text Color Scheme",
      "options": [
        { "value": "dark", "label": "Dark Text (#000)" },
        { "value": "light", "label": "Light Text (#fff)" }
      ],
      "default": "dark"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Readability Gradient / Scrim",
      "default": 15,
      "info": "Subtle background gradient behind text to guarantee contrast"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Primary Button Text",
      "default": "SHOP NEW DROP"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Secondary Button Text",
      "default": "EXPLORE ALL"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Bottom Left Corner (Optional Tag/Link)"
    },
    {
      "type": "text",
      "id": "corner_tag",
      "label": "Corner Badge / Tag",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "corner_button_text",
      "label": "Corner Quick Link",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "corner_button_link",
      "label": "Corner Link"
    }
  ],
  "presets": [
    {
      "name": "Editorial Hero Banner"
    }
  ]
}
{% endschema %}

{% liquid
  assign height_class = 'hero-editorial--large'
  if section.settings.image_height == 'full'
    assign height_class = 'hero-editorial--full'
  elsif section.settings.image_height == 'medium'
    assign height_class = 'hero-editorial--medium'
  endif
%}

<div class="hero-editorial full-width full-width-image-container {{ height_class }} hero-editorial--color-{{ section.settings.text_color }} hero-editorial--pos-{{ section.settings.content_position }}" id="HeroEditorial-{{ section.id }}">
  <!-- Background Image -->
  <div class="hero-editorial__media">
    {% if section.settings.image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
        {% endif %}
        <img
          src="{{ section.settings.image | image_url: width: 2400 }}"
          alt="{{ section.settings.image.alt | escape | default: section.settings.heading | strip_newlines }}"
          class="hero-editorial__img"
          loading="eager"
          fetchpriority="high"
          width="2400"
          height="{{ 2400 | divided_by: section.settings.image.aspect_ratio | round }}"
          style="object-position: {{ section.settings.image_position }};"
        >
      </picture>
    {% else %}
      <div class="hero-editorial__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}

    <!-- Scrim / Gradient for text readability -->
    {% if section.settings.scrim_opacity > 0 %}
      <div 
        class="hero-editorial__scrim hero-editorial__scrim--{{ section.settings.content_position }} hero-editorial__scrim--{{ section.settings.text_color }}"
        style="opacity: {{ section.settings.scrim_opacity | divided_by: 100.0 }};"
      ></div>
    {% endif %}
  </div>

  <!-- Editorial Content Container -->
  <div class="hero-editorial__container">
    <div class="hero-editorial__content">
      {% if section.settings.tag != blank %}
        <span class="hero-editorial__tag">{{ section.settings.tag }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hero-editorial__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="hero-editorial__text">
          {{ section.settings.text }}
        </p>
      {% endif %}

      {% if section.settings.button_1_text != blank or section.settings.button_2_text != blank %}
        <div class="hero-editorial__actions">
          {% if section.settings.button_1_text != blank %}
            <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="hero-editorial__btn hero-editorial__btn--primary">
              {{ section.settings.button_1_text }}
            </a>
          {% endif %}
          {% if section.settings.button_2_text != blank %}
            <a href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}" class="hero-editorial__btn hero-editorial__btn--secondary">
              {{ section.settings.button_2_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- Bottom Left Corner Badge & Quick Link -->
    {% if section.settings.corner_tag != blank or section.settings.corner_button_text != blank %}
      <div class="hero-editorial__corner">
        {% if section.settings.corner_tag != blank %}
          <span class="hero-editorial__corner-tag">{{ section.settings.corner_tag }}</span>
        {% endif %}
        {% if section.settings.corner_button_text != blank %}
          <a href="{{ section.settings.corner_button_link | default: routes.all_products_collection_url }}" class="hero-editorial__corner-btn">
            {{ section.settings.corner_button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  /* Break out of .shopify-section grid and span 100vw edge-to-edge */
  .hero-editorial-section,
  .shopify-section:has(.hero-editorial),
  .shopify-section.hero-editorial-section {
    display: block !important;
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    padding: 0 !important;
    grid-column: 1 / -1 !important;
    /* Pull hero up behind announcement bar and transparent header */
    margin-top: calc(-1 * (var(--announcement-height, 46px) + var(--site-header-height, 0px))) !important;
    z-index: 0;
  }

  .main-content:has(.hero-editorial-section),
  .main-content:has(.hero-editorial) {
    gap: 0 !important;
  }

  @media (max-width: 768px) {
    .main-content:has(.hero-editorial-section),
    .main-content:has(.hero-editorial) {
      padding-top: 0 !important;
    }
  }

  .hero-editorial {
    position: relative;
    width: 100vw !important;
    max-width: 100vw !important;
    margin: 0 !important;
    overflow: hidden;
    display: flex;
    align-items: center;
    grid-column: 1 / -1 !important;
  }

  .hero-editorial--full,
  .hero-editorial--large {
    height: 100svh;
    min-height: 100vh;
  }

  .hero-editorial--medium {
    height: 75svh;
    min-height: 520px;
  }

  .hero-editorial__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-editorial__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-editorial__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-editorial__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface, #f2f2f2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-editorial__placeholder svg {
    max-width: 50%;
    max-height: 50%;
    opacity: 0.3;
  }

  /* Scrim Gradients for contrast */
  .hero-editorial__scrim {
    position: absolute;
    top: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 2;
  }

  .hero-editorial__scrim--right.hero-editorial__scrim--dark {
    right: 0;
    width: 55%;
    background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.45) 50%, rgba(255, 255, 255, 0.75) 100%);
  }

  .hero-editorial__scrim--right.hero-editorial__scrim--light {
    right: 0;
    width: 55%;
    background: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.45) 50%, rgba(0, 0, 0, 0.75) 100%);
  }

  .hero-editorial__scrim--left.hero-editorial__scrim--dark {
    left: 0;
    width: 55%;
    background: linear-gradient(to left, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.45) 50%, rgba(255, 255, 255, 0.75) 100%);
  }

  .hero-editorial__scrim--left.hero-editorial__scrim--light {
    left: 0;
    width: 55%;
    background: linear-gradient(to left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.45) 50%, rgba(0, 0, 0, 0.75) 100%);
  }

  /* Container */
  .hero-editorial__container {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    max-width: 100%;
    margin: 0;
    padding: 100px 3vw 40px 3vw;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Content Positioning - pushed towards outer margins */
  .hero-editorial--pos-right .hero-editorial__container {
    align-items: flex-end;
    padding-right: clamp(16px, 3.5vw, 50px);
  }

  .hero-editorial--pos-left .hero-editorial__container {
    align-items: flex-start;
    padding-left: clamp(16px, 3.5vw, 50px);
  }

  /* Editorial Content - Raw typography directly on photo, no card/box */
  .hero-editorial__content {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-sizing: border-box;
  }

  .hero-editorial--color-dark .hero-editorial__content,
  .hero-editorial--color-light .hero-editorial__content {
    background: transparent;
    border: none;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Colors */
  .hero-editorial--color-dark .hero-editorial__tag {
    color: #444444;
  }
  .hero-editorial--color-dark .hero-editorial__heading {
    color: #000000;
  }
  .hero-editorial--color-dark .hero-editorial__text {
    color: #222222;
  }

  .hero-editorial--color-light .hero-editorial__tag {
    color: rgba(255, 255, 255, 0.85);
  }
  .hero-editorial--color-light .hero-editorial__heading {
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }
  .hero-editorial--color-light .hero-editorial__text {
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }

  /* Tag */
  .hero-editorial__tag {
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: inline-block;
  }

  /* Monumental Heading (Nude Project style) */
  .hero-editorial__heading {
    font-family: var(--font-heading-family, 'Century Gothic', -apple-system, sans-serif);
    font-size: clamp(38px, 5.4vw, 80px);
    font-weight: 900;
    line-height: 0.90;
    letter-spacing: -0.025em;
    text-transform: none;
    margin: 0 0 20px 0;
    word-break: normal;
  }

  /* Editorial Description Paragraph */
  .hero-editorial__text {
    font-family: var(--font-primary-family, 'Century Gothic', sans-serif);
    font-size: clamp(11.5px, 0.9vw, 13.5px);
    line-height: 1.5;
    max-width: 360px;
    margin: 0 0 26px 0;
    letter-spacing: 0.01em;
  }

  /* Action Buttons */
  .hero-editorial__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    width: 100%;
  }

  .hero-editorial__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 9999px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  /* Button Themes */
  .hero-editorial--color-dark .hero-editorial__btn--primary {
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
  }

  .hero-editorial--color-dark .hero-editorial__btn--primary:hover {
    background-color: var(--color-primary, #8b1e2d);
    border-color: var(--color-primary, #8b1e2d);
    color: #ffffff;
  }

  .hero-editorial--color-dark .hero-editorial__btn--secondary {
    background-color: transparent;
    color: #000000;
    border: 1px solid rgba(0, 0, 0, 0.5);
  }

  .hero-editorial--color-dark .hero-editorial__btn--secondary:hover {
    border-color: #000000;
    background-color: rgba(0, 0, 0, 0.06);
  }

  .hero-editorial--color-light .hero-editorial__btn--primary {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #ffffff;
  }

  .hero-editorial--color-light .hero-editorial__btn--primary:hover {
    background-color: var(--color-primary, #8b1e2d);
    border-color: var(--color-primary, #8b1e2d);
    color: #ffffff;
  }

  .hero-editorial--color-light .hero-editorial__btn--secondary {
    background-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
  }

  .hero-editorial--color-light .hero-editorial__btn--secondary:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.3);
  }

  /* Bottom Left Corner - Clean badge & pill button, no wrapper box */
  .hero-editorial__corner {
    position: absolute;
    bottom: 32px;
    left: clamp(20px, 3.5vw, 50px);
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    z-index: 4;
  }

  .hero-editorial--color-dark .hero-editorial__corner {
    background: transparent;
    border: none;
    box-shadow: none;
    color: #000000;
  }

  .hero-editorial--color-light .hero-editorial__corner {
    background: transparent;
    border: none;
    box-shadow: none;
    color: #ffffff;
  }

  .hero-editorial__corner-tag {
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hero-editorial__corner-btn {
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 8px 20px;
    border-radius: 9999px;
    transition: all 0.2s ease;
  }

  .hero-editorial--color-dark .hero-editorial__corner-btn {
    background: #000000;
    color: #ffffff;
    border: 1px solid #000000;
  }

  .hero-editorial--color-dark .hero-editorial__corner-btn:hover {
    background: var(--color-primary, #8b1e2d);
    border-color: var(--color-primary, #8b1e2d);
    color: #ffffff;
  }

  .hero-editorial--color-light .hero-editorial__corner-btn {
    background: #ffffff;
    color: #000000;
    border: 1px solid #ffffff;
  }

  .hero-editorial--color-light .hero-editorial__corner-btn:hover {
    background: var(--color-primary, #8b1e2d);
    border-color: var(--color-primary, #8b1e2d);
    color: #ffffff;
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .hero-editorial__container {
      padding: 90px 4vw 40px 4vw;
    }
    .hero-editorial__content {
      max-width: 440px;
    }
    .hero-editorial__heading {
      font-size: clamp(32px, 4.8vw, 56px);
    }
  }

  @media (max-width: 768px) {
    .hero-editorial {
      height: 100svh !important;
      min-height: 580px !important;
      max-height: 100svh;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: stretch;
      background: #000000;
    }

    .hero-editorial__media {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .hero-editorial__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top !important;
    }

    .hero-editorial__scrim {
      display: none !important;
    }

    .hero-editorial__container {
      position: relative;
      z-index: 3;
      width: 100%;
      height: auto;
      padding: 0 20px calc(env(safe-area-inset-bottom, 0px) + 24px) 20px !important;
      margin: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: stretch !important;
      background: transparent !important;
    }

    .hero-editorial__corner {
      position: static !important;
      order: -1;
      align-self: flex-start;
      margin-bottom: 12px;
      padding: 0 !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      gap: 12px;
    }

    .hero-editorial__corner-tag {
      font-size: 10px;
      letter-spacing: 1.5px;
    }

    .hero-editorial__corner-btn {
      font-size: 10px;
      padding: 6px 14px;
      letter-spacing: 1.2px;
      border-radius: 9999px;
    }

    .hero-editorial__content {
      width: 100%;
      max-width: 100% !important;
      padding: 0 !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }

    .hero-editorial--color-dark .hero-editorial__content,
    .hero-editorial--color-light .hero-editorial__content {
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
    }

    .hero-editorial__tag {
      font-size: 10px;
      letter-spacing: 2px;
      margin-bottom: 6px;
    }

    .hero-editorial__heading {
      font-size: clamp(26px, 7vw, 36px) !important;
      line-height: 0.95;
      letter-spacing: -0.02em;
      margin: 0 0 10px 0;
    }

    .hero-editorial__text {
      font-size: 12px;
      line-height: 1.45;
      margin: 0 0 16px 0;
      max-width: 100%;
      opacity: 0.9;
    }

    .hero-editorial__actions {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .hero-editorial__btn {
      padding: 10px 18px;
      font-size: 10px;
      letter-spacing: 1.4px;
      text-align: center;
      border-radius: 9999px;
    }
  }

  @media (max-width: 480px) {
    .hero-editorial__heading {
      font-size: clamp(22px, 6vw, 30px) !important;
    }
    .hero-editorial__text {
      font-size: 11.5px;
      line-height: 1.4;
      margin-bottom: 14px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hero = document.getElementById('HeroEditorial-{{ section.id }}');
    if (!hero) return;

    const filterLinks = hero.querySelectorAll('a[href*="type="], a.hero-editorial__corner-btn, a[href*="/pages/all-products"]');
    filterLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        try {
          const href = link.getAttribute('href');
          if (!href) return;
          const url = new URL(href, window.location.origin);

          if (url.pathname === window.location.pathname) {
            e.preventDefault();
            const targetType = url.searchParams.get('type') || '';
            window.history.pushState({}, '', url.pathname + (url.search ? url.search : ''));
            window.dispatchEvent(new CustomEvent('filterProductsByType', { detail: { type: targetType } }));

            const targetSection = document.querySelector('.new-in-section, .old-collections-section, .collection-products, .new-arrivals-section');
            if (targetSection) {
              const yOffset = -70;
              const y = targetSection.getBoundingClientRect().top + window.pageYOffset + yOffset;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }
          }
        } catch (err) {
          // Allow default link behavior on error
        }
      });
    });
  });
</script>
