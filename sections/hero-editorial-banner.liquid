{% schema %}
{
  "name": "Editorial Hero Banner",
  "tag": "section",
  "class": "hero-editorial-section",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Banner Height",
      "options": [
        { "value": "full", "label": "Full Screen (100vh)" },
        { "value": "large", "label": "Large (85vh)" },
        { "value": "medium", "label": "Medium (70vh)" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Focus / Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "left center", "label": "Left (models on left)" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top Center" }
      ],
      "default": "left center"
    },
    {
      "type": "header",
      "content": "Content & Typography"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Eyebrow / Sub-tag",
      "default": "SECRETS & SINS • DROP 01"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main Headline",
      "default": "NOT MADE\nFOR EVERYONE",
      "info": "Use line breaks to stack words for high visual impact"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Editorial Paragraph",
      "default": "A collection built on unfiltered expression. Heavyweight 280gsm cotton, relaxed boxy silhouettes, and distinct graphics made to outlast every trend. Secrets kept, sins committed."
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position (Desktop)",
      "options": [
        { "value": "right", "label": "Right Side" },
        { "value": "left", "label": "Left Side" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text Color Scheme",
      "options": [
        { "value": "dark", "label": "Dark Text (#000)" },
        { "value": "light", "label": "Light Text (#fff)" }
      ],
      "default": "dark"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Readability Gradient / Scrim",
      "default": 15,
      "info": "Subtle background gradient behind text to guarantee contrast"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Primary Button Text",
      "default": "SHOP NEW DROP"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Secondary Button Text",
      "default": "EXPLORE ALL"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Bottom Left Corner (Optional Tag/Link)"
    },
    {
      "type": "text",
      "id": "corner_tag",
      "label": "Corner Badge / Tag",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "corner_button_text",
      "label": "Corner Quick Link",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "corner_button_link",
      "label": "Corner Link"
    }
  ],
  "presets": [
    {
      "name": "Editorial Hero Banner"
    }
  ]
}
{% endschema %}

{% liquid
  assign height_class = 'hero-editorial--large'
  if section.settings.image_height == 'full'
    assign height_class = 'hero-editorial--full'
  elsif section.settings.image_height == 'medium'
    assign height_class = 'hero-editorial--medium'
  endif
%}

<div class="hero-editorial {{ height_class }} hero-editorial--color-{{ section.settings.text_color }} hero-editorial--pos-{{ section.settings.content_position }}" id="HeroEditorial-{{ section.id }}">
  <!-- Background Image -->
  <div class="hero-editorial__media">
    {% if section.settings.image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
        {% endif %}
        <img
          src="{{ section.settings.image | image_url: width: 2400 }}"
          alt="{{ section.settings.image.alt | escape | default: section.settings.heading | strip_newlines }}"
          class="hero-editorial__img"
          loading="eager"
          fetchpriority="high"
          width="2400"
          height="{{ 2400 | divided_by: section.settings.image.aspect_ratio | round }}"
          style="object-position: {{ section.settings.image_position }};"
        >
      </picture>
    {% else %}
      <div class="hero-editorial__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}

    <!-- Scrim / Gradient for text readability -->
    {% if section.settings.scrim_opacity > 0 %}
      <div 
        class="hero-editorial__scrim hero-editorial__scrim--{{ section.settings.content_position }} hero-editorial__scrim--{{ section.settings.text_color }}"
        style="opacity: {{ section.settings.scrim_opacity | divided_by: 100.0 }};"
      ></div>
    {% endif %}
  </div>

  <!-- Editorial Content Container -->
  <div class="hero-editorial__container">
    <div class="hero-editorial__content">
      {% if section.settings.tag != blank %}
        <span class="hero-editorial__tag">{{ section.settings.tag }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hero-editorial__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="hero-editorial__text">
          {{ section.settings.text }}
        </p>
      {% endif %}

      {% if section.settings.button_1_text != blank or section.settings.button_2_text != blank %}
        <div class="hero-editorial__actions">
          {% if section.settings.button_1_text != blank %}
            <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="hero-editorial__btn hero-editorial__btn--primary">
              {{ section.settings.button_1_text }}
            </a>
          {% endif %}
          {% if section.settings.button_2_text != blank %}
            <a href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}" class="hero-editorial__btn hero-editorial__btn--secondary">
              {{ section.settings.button_2_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- Bottom Left Corner Badge & Quick Link -->
    {% if section.settings.corner_tag != blank or section.settings.corner_button_text != blank %}
      <div class="hero-editorial__corner">
        {% if section.settings.corner_tag != blank %}
          <span class="hero-editorial__corner-tag">{{ section.settings.corner_tag }}</span>
        {% endif %}
        {% if section.settings.corner_button_text != blank %}
          <a href="{{ section.settings.corner_button_link | default: routes.all_products_collection_url }}" class="hero-editorial__corner-btn">
            {{ section.settings.corner_button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  .hero-editorial {
    position: relative;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .hero-editorial--full {
    height: 100svh;
    min-height: 600px;
  }

  .hero-editorial--large {
    height: calc(100svh - 60px);
    min-height: 560px;
  }

  .hero-editorial--medium {
    height: 72svh;
    min-height: 480px;
  }

  .hero-editorial__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-editorial__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-editorial__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-editorial__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface, #f2f2f2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-editorial__placeholder svg {
    max-width: 50%;
    max-height: 50%;
    opacity: 0.3;
  }

  /* Scrim Gradients for contrast */
  .hero-editorial__scrim {
    position: absolute;
    top: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 2;
  }

  .hero-editorial__scrim--right.hero-editorial__scrim--dark {
    right: 0;
    width: 65%;
    background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.85) 55%, rgba(255, 255, 255, 0.98) 100%);
  }

  .hero-editorial__scrim--right.hero-editorial__scrim--light {
    right: 0;
    width: 65%;
    background: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.6) 55%, rgba(0, 0, 0, 0.88) 100%);
  }

  .hero-editorial__scrim--left.hero-editorial__scrim--dark {
    left: 0;
    width: 65%;
    background: linear-gradient(to left, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.85) 55%, rgba(255, 255, 255, 0.98) 100%);
  }

  .hero-editorial__scrim--left.hero-editorial__scrim--light {
    left: 0;
    width: 65%;
    background: linear-gradient(to left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.6) 55%, rgba(0, 0, 0, 0.88) 100%);
  }

  /* Container */
  .hero-editorial__container {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding: 120px 4vw 60px 4vw;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Content Positioning */
  .hero-editorial--pos-right .hero-editorial__container {
    align-items: flex-end;
  }

  .hero-editorial--pos-left .hero-editorial__container {
    align-items: flex-start;
  }

  .hero-editorial__content {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Colors */
  .hero-editorial--color-dark .hero-editorial__tag {
    color: #444444;
  }
  .hero-editorial--color-dark .hero-editorial__heading {
    color: #000000;
  }
  .hero-editorial--color-dark .hero-editorial__text {
    color: #333333;
  }
  .hero-editorial--color-dark .hero-editorial__corner {
    color: #000000;
  }

  .hero-editorial--color-light .hero-editorial__tag {
    color: rgba(255, 255, 255, 0.8);
  }
  .hero-editorial--color-light .hero-editorial__heading {
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }
  .hero-editorial--color-light .hero-editorial__text {
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }
  .hero-editorial--color-light .hero-editorial__corner {
    color: #ffffff;
  }

  /* Tag */
  .hero-editorial__tag {
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: inline-block;
  }

  /* Monumental Heading (Nude Project style) */
  .hero-editorial__heading {
    font-family: var(--font-heading-family, 'Century Gothic', -apple-system, sans-serif);
    font-size: clamp(38px, 5.8vw, 76px);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.025em;
    text-transform: none;
    margin: 0 0 24px 0;
    word-break: normal;
  }

  /* Editorial Description Paragraph */
  .hero-editorial__text {
    font-family: var(--font-primary-family, 'Century Gothic', sans-serif);
    font-size: 13px;
    line-height: 1.6;
    max-width: 420px;
    margin: 0 0 32px 0;
    letter-spacing: 0.01em;
  }

  /* Action Buttons */
  .hero-editorial__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .hero-editorial__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 28px;
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  /* Button Themes */
  .hero-editorial--color-dark .hero-editorial__btn--primary {
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
  }

  .hero-editorial--color-dark .hero-editorial__btn--primary:hover {
    background-color: var(--color-primary, #8b1e2d);
    border-color: var(--color-primary, #8b1e2d);
    color: #ffffff;
  }

  .hero-editorial--color-dark .hero-editorial__btn--secondary {
    background-color: transparent;
    color: #000000;
    border: 1px solid rgba(0, 0, 0, 0.35);
  }

  .hero-editorial--color-dark .hero-editorial__btn--secondary:hover {
    border-color: #000000;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .hero-editorial--color-light .hero-editorial__btn--primary {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #ffffff;
  }

  .hero-editorial--color-light .hero-editorial__btn--primary:hover {
    background-color: var(--color-primary, #8b1e2d);
    border-color: var(--color-primary, #8b1e2d);
    color: #ffffff;
  }

  .hero-editorial--color-light .hero-editorial__btn--secondary {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(8px);
  }

  .hero-editorial--color-light .hero-editorial__btn--secondary:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.25);
  }

  /* Bottom Left Corner Badge & Quick Link */
  .hero-editorial__corner {
    position: absolute;
    bottom: 30px;
    left: 4vw;
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 4;
  }

  .hero-editorial__corner-tag {
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hero-editorial__corner-btn {
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid currentColor;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .hero-editorial__corner-btn:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .hero-editorial__container {
      padding: 100px 5vw 40px 5vw;
    }
    .hero-editorial__content {
      max-width: 480px;
    }
  }

  @media (max-width: 768px) {
    .hero-editorial {
      height: auto !important;
      min-height: unset;
      flex-direction: column;
    }

    .hero-editorial__media {
      position: relative;
      width: 100%;
      height: 70vh;
      min-height: 420px;
    }

    .hero-editorial__scrim {
      display: none;
    }

    .hero-editorial__container {
      position: relative;
      padding: 30px 20px 40px 20px;
      align-items: flex-start !important;
      background-color: var(--color-background, #ffffff);
    }

    .hero-editorial--color-light .hero-editorial__container {
      background-color: #000000;
    }

    .hero-editorial__content {
      max-width: 100%;
    }

    .hero-editorial__heading {
      font-size: clamp(32px, 8vw, 44px);
      line-height: 1.05;
      margin-bottom: 16px;
    }

    .hero-editorial__text {
      font-size: 13px;
      margin-bottom: 24px;
    }

    .hero-editorial__corner {
      position: relative;
      bottom: auto;
      left: auto;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--color-border, #e5e5e5);
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
