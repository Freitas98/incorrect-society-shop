{% schema %}
{
  "name": "Editorial Hero Banner",
  "tag": "section",
  "class": "hero-editorial-section",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Banner Height",
      "options": [
        { "value": "full", "label": "Full Screen (100vh)" },
        { "value": "large", "label": "Full Screen (100vh)" },
        { "value": "medium", "label": "Medium (75vh)" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Focus / Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "left center", "label": "Left (models on left)" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top Center" }
      ],
      "default": "left center"
    },
    {
      "type": "header",
      "content": "Content & Typography"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Eyebrow / Sub-tag",
      "default": "SECRETS & SINS • DROP 01"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main Headline",
      "default": "NOT MADE\nFOR EVERYONE",
      "info": "Use line breaks to stack words for high visual impact"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Editorial Paragraph",
      "default": "A collection built on unfiltered expression. Heavyweight 280gsm cotton, relaxed boxy silhouettes, and distinct graphics made to outlast every trend. Secrets kept, sins committed."
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position (Desktop)",
      "options": [
        { "value": "right", "label": "Right Side" },
        { "value": "left", "label": "Left Side" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text Color Scheme",
      "options": [
        { "value": "auto", "label": "Auto-Invert / Subtrair Fundo (Difference)" },
        { "value": "dark", "label": "Dark Text (#000)" },
        { "value": "light", "label": "Light Text (#fff)" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Readability Gradient / Scrim",
      "default": 15,
      "info": "Subtle background gradient behind text to guarantee contrast"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Primary Button Text",
      "default": "SHOP NEW DROP"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Secondary Button Text",
      "default": "EXPLORE ALL"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Bottom Left Corner (Optional Tag/Link)"
    },
    {
      "type": "text",
      "id": "corner_tag",
      "label": "Corner Badge / Tag",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "corner_heading",
      "label": "Corner Title / Collection Name",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "corner_button_text",
      "label": "Corner Quick Link",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "corner_button_link",
      "label": "Corner Link"
    }
  ],
  "presets": [
    {
      "name": "Editorial Hero Banner"
    }
  ]
}
{% endschema %}

{% liquid
  assign height_class = 'hero-editorial--large'
  if section.settings.image_height == 'full'
    assign height_class = 'hero-editorial--full'
  elsif section.settings.image_height == 'medium'
    assign height_class = 'hero-editorial--medium'
  endif
%}

<div class="hero-editorial full-width full-width-image-container {{ height_class }} hero-editorial--color-{{ section.settings.text_color }} hero-editorial--pos-{{ section.settings.content_position }}" id="HeroEditorial-{{ section.id }}">
  <!-- Background Image -->
  <div class="hero-editorial__media">
    {% if section.settings.image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
        {% endif %}
        <img
          src="{{ section.settings.image | image_url: width: 2400 }}"
          alt="{{ section.settings.image.alt | escape | default: section.settings.heading | strip_newlines }}"
          class="hero-editorial__img"
          loading="eager"
          fetchpriority="high"
          width="2400"
          height="{{ 2400 | divided_by: section.settings.image.aspect_ratio | round }}"
          style="object-position: {{ section.settings.image_position }};"
        >
      </picture>
    {% else %}
      <div class="hero-editorial__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}

    <!-- Scrim / Gradient for text readability -->
    {% if section.settings.scrim_opacity > 0 %}
      <div 
        class="hero-editorial__scrim hero-editorial__scrim--{{ section.settings.content_position }} hero-editorial__scrim--{{ section.settings.text_color }}"
        style="opacity: {{ section.settings.scrim_opacity | divided_by: 100.0 }};"
      ></div>
    {% endif %}
  </div>

  <!-- Squeezed Editorial Column (Right by default, or Left) -->
  <div class="hero-editorial__column hero-editorial__column--{{ section.settings.content_position }}">
    <div class="hero-editorial__column-top">
      {% if section.settings.tag != blank %}
        <span class="hero-editorial__tag">{{ section.settings.tag }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hero-editorial__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {% endif %}
    </div>

    <div class="hero-editorial__column-bottom">
      {% if section.settings.text != blank %}
        <p class="hero-editorial__text">
          {{ section.settings.text }}
        </p>
      {% endif %}
    </div>
  </div>

  <!-- Bottom Corner Area (Bottom-Left by default) -->
  {% if section.settings.corner_tag != blank or section.settings.corner_heading != blank or section.settings.button_1_text != blank or section.settings.button_2_text != blank or section.settings.corner_button_text != blank %}
    <div class="hero-editorial__corner hero-editorial__corner--{{ section.settings.content_position }}">
      {% if section.settings.corner_tag != blank or section.settings.corner_heading != blank %}
        <div class="hero-editorial__corner-text">
          {% if section.settings.corner_tag != blank %}
            <span class="hero-editorial__corner-tag">{{ section.settings.corner_tag }}</span>
          {% endif %}

          {% if section.settings.corner_heading != blank %}
            <h3 class="hero-editorial__corner-heading">{{ section.settings.corner_heading }}</h3>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.button_1_text != blank or section.settings.button_2_text != blank or section.settings.corner_button_text != blank %}
        <div class="hero-editorial__actions">
          {% if section.settings.button_1_text != blank %}
            <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="hero-editorial__btn hero-editorial__btn--primary">
              {{ section.settings.button_1_text }}
            </a>
          {% endif %}
          {% if section.settings.button_2_text != blank %}
            <a href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}" class="hero-editorial__btn hero-editorial__btn--secondary">
              {{ section.settings.button_2_text }}
            </a>
          {% elsif section.settings.corner_button_text != blank and section.settings.button_1_text == blank %}
            <a href="{{ section.settings.corner_button_link | default: routes.all_products_collection_url }}" class="hero-editorial__btn hero-editorial__btn--primary">
              {{ section.settings.corner_button_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

<style>
  /* Break out of .shopify-section grid and span 100vw edge-to-edge */
  .hero-editorial-section,
  .shopify-section:has(.hero-editorial),
  .shopify-section.hero-editorial-section {
    display: block !important;
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    padding: 0 !important;
    grid-column: 1 / -1 !important;
    /* Pull hero up behind announcement bar and transparent header */
    margin-top: calc(-1 * (var(--announcement-height, 46px) + var(--site-header-height, 0px))) !important;
    z-index: 0;
  }

  .main-content:has(.hero-editorial-section),
  .main-content:has(.hero-editorial) {
    gap: 0 !important;
  }

  @media (max-width: 768px) {
    .main-content:has(.hero-editorial-section),
    .main-content:has(.hero-editorial) {
      padding-top: 0 !important;
    }
  }

  .hero-editorial {
    position: relative;
    width: 100vw !important;
    max-width: 100vw !important;
    margin: 0 !important;
    overflow: hidden;
    grid-column: 1 / -1 !important;
  }

  .hero-editorial--full,
  .hero-editorial--large {
    height: 100svh;
    min-height: 100vh;
  }

  .hero-editorial--medium {
    height: 75svh;
    min-height: 520px;
  }

  .hero-editorial__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-editorial__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-editorial__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-editorial__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface, #f2f2f2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-editorial__placeholder svg {
    max-width: 50%;
    max-height: 50%;
    opacity: 0.3;
  }

  /* Scrim Gradients for contrast (rendered only if scrim_opacity > 0) */
  .hero-editorial__scrim {
    position: absolute;
    top: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 2;
  }

  .hero-editorial__scrim--right.hero-editorial__scrim--dark {
    right: 0;
    width: 45%;
    background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.4) 55%, rgba(255, 255, 255, 0.75) 100%);
  }

  .hero-editorial__scrim--right.hero-editorial__scrim--light {
    right: 0;
    width: 45%;
    background: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.4) 55%, rgba(0, 0, 0, 0.75) 100%);
  }

  .hero-editorial__scrim--left.hero-editorial__scrim--dark {
    left: 0;
    width: 45%;
    background: linear-gradient(to left, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.4) 55%, rgba(255, 255, 255, 0.75) 100%);
  }

  .hero-editorial__scrim--left.hero-editorial__scrim--light {
    left: 0;
    width: 45%;
    background: linear-gradient(to left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.4) 55%, rgba(0, 0, 0, 0.75) 100%);
  }

  /* Squeezed Editorial Column - Desktop */
  .hero-editorial__column {
    position: absolute;
    top: calc(var(--announcement-height, 46px) + var(--site-header-height, 80px) + 24px);
    bottom: clamp(28px, 4vw, 44px);
    width: clamp(280px, 25vw, 420px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: 3;
    pointer-events: auto;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .hero-editorial__column--right {
    right: clamp(20px, 3.5vw, 60px);
    align-items: flex-end;
  }

  .hero-editorial__column--left {
    left: clamp(20px, 3.5vw, 60px);
    align-items: flex-start;
  }

  /* Column Top (Tag + Headline) */
  .hero-editorial__column-top {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-editorial__tag {
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: block;
  }

  /* Monumental Squeezed Heading - MUITO MAIOR */
  .hero-editorial__heading {
    font-family: var(--font-heading-family, 'Century Gothic', -apple-system, sans-serif);
    font-size: clamp(52px, 6.4vw, 108px);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.035em;
    text-transform: none;
    margin: 0;
    word-break: normal;
    overflow-wrap: break-word;
    text-align: left;
    width: 100%;
  }

  /* Column Bottom (Description text) */
  .hero-editorial__column-bottom {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .hero-editorial__column--right .hero-editorial__column-bottom {
    align-items: flex-end;
  }

  .hero-editorial__column--left .hero-editorial__column-bottom {
    align-items: flex-start;
  }

  /* Bolder, High-Contrast Editorial Description - MAIOR E MAIS BOLD */
  .hero-editorial__text {
    font-family: var(--font-primary-family, 'Century Gothic', sans-serif);
    font-size: clamp(14.5px, 1.1vw, 17.5px);
    font-weight: 800;
    line-height: 1.34;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: clamp(280px, 23vw, 380px);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .hero-editorial__column--right .hero-editorial__text {
    text-align: right;
  }

  .hero-editorial__column--left .hero-editorial__text {
    text-align: left;
  }

  /* AUTO-INVERT / SUBTRAIR FUNDO (Difference Mode) */
  .hero-editorial--color-auto .hero-editorial__tag,
  .hero-editorial--color-auto .hero-editorial__heading,
  .hero-editorial--color-auto .hero-editorial__text,
  .hero-editorial--color-auto .hero-editorial__corner-tag,
  .hero-editorial--color-auto .hero-editorial__corner-heading {
    color: #ffffff !important;
    mix-blend-mode: difference !important;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .hero-editorial--color-auto .hero-editorial__btn {
    background-color: rgba(255, 255, 255, 0.88);
    color: #000000;
    border: 1px solid rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    font-weight: 700;
  }

  .hero-editorial--color-auto .hero-editorial__btn:hover {
    background-color: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  /* Color Schemes for raw typography on photo */
  .hero-editorial--color-dark .hero-editorial__heading {
    color: #000000;
  }
  .hero-editorial--color-dark .hero-editorial__text {
    color: #000000;
  }
  .hero-editorial--color-dark .hero-editorial__tag {
    color: #222222;
  }
  .hero-editorial--color-dark .hero-editorial__corner {
    color: #000000;
  }
  .hero-editorial--color-dark .hero-editorial__corner-tag {
    color: #333333;
  }
  .hero-editorial--color-dark .hero-editorial__corner-heading {
    color: #000000;
  }

  .hero-editorial--color-light .hero-editorial__heading {
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.45);
  }
  .hero-editorial--color-light .hero-editorial__text {
    color: #ffffff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }
  .hero-editorial--color-light .hero-editorial__tag {
    color: rgba(255, 255, 255, 0.85);
  }
  .hero-editorial--color-light .hero-editorial__corner {
    color: #ffffff;
  }
  .hero-editorial--color-light .hero-editorial__corner-tag {
    color: rgba(255, 255, 255, 0.8);
  }
  .hero-editorial--color-light .hero-editorial__corner-heading {
    color: #ffffff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
  }

  /* Bottom Corner Area - Desktop */
  .hero-editorial__corner {
    position: absolute;
    bottom: clamp(28px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 3;
    pointer-events: auto;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .hero-editorial__corner--right {
    left: clamp(20px, 3.5vw, 60px);
    align-items: flex-start;
  }

  .hero-editorial__corner--left {
    right: clamp(20px, 3.5vw, 60px);
    align-items: flex-end;
  }

  .hero-editorial__corner-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-editorial__corner-tag {
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hero-editorial__corner-heading {
    font-family: var(--font-heading-family, 'Century Gothic', sans-serif);
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 6px 0;
  }

  /* Pill Action Buttons */
  .hero-editorial__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .hero-editorial__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 22px;
    font-family: var(--font-primary-family, 'Century Gothic', sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
    border-radius: 9999px;
    transition: all 0.22s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .hero-editorial--color-dark .hero-editorial__btn {
    background-color: rgba(255, 255, 255, 0.85);
    color: #000000;
    border: 1px solid rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero-editorial--color-dark .hero-editorial__btn:hover {
    background-color: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  .hero-editorial--color-light .hero-editorial__btn {
    background-color: rgba(0, 0, 0, 0.35);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero-editorial--color-light .hero-editorial__btn:hover {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .hero-editorial__column {
      width: clamp(260px, 28vw, 360px);
    }
    .hero-editorial__heading {
      font-size: clamp(40px, 5.5vw, 70px);
    }
    .hero-editorial__text {
      font-size: clamp(13px, 1.2vw, 15px);
    }
  }

  @media (max-width: 768px) {
    .hero-editorial {
      height: 100svh !important;
      min-height: 560px !important;
      max-height: 100svh;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: stretch;
      padding: 0 20px calc(env(safe-area-inset-bottom, 0px) + 24px) 20px !important;
      box-sizing: border-box;
      background: #000000;
    }

    .hero-editorial__media {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .hero-editorial__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top !important;
    }

    .hero-editorial__scrim {
      display: none !important;
    }

    .hero-editorial__column {
      position: relative !important;
      top: auto !important;
      bottom: auto !important;
      left: auto !important;
      right: auto !important;
      width: 100% !important;
      max-width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-end !important;
      align-items: flex-start !important;
      z-index: 3;
      margin: 0 !important;
    }

    .hero-editorial__column-top,
    .hero-editorial__column-bottom {
      width: 100% !important;
      align-items: flex-start !important;
      text-align: left !important;
    }

    .hero-editorial__tag {
      font-size: 11px;
      letter-spacing: 2px;
      margin-bottom: 6px;
    }

    .hero-editorial__heading {
      font-size: clamp(34px, 9vw, 50px) !important;
      line-height: 0.92 !important;
      letter-spacing: -0.025em !important;
      margin: 0 0 10px 0 !important;
      text-align: left !important;
    }

    .hero-editorial__text {
      font-size: 14px !important;
      font-weight: 800 !important;
      line-height: 1.36 !important;
      max-width: 100% !important;
      text-align: left !important;
      margin: 0 0 16px 0 !important;
    }

    .hero-editorial__corner {
      position: relative !important;
      top: auto !important;
      bottom: auto !important;
      left: auto !important;
      right: auto !important;
      width: 100% !important;
      margin-top: 0 !important;
      z-index: 3;
    }

    .hero-editorial__corner-heading,
    .hero-editorial__corner-tag {
      display: none !important;
    }

    .hero-editorial__actions {
      display: flex !important;
      flex-direction: row !important;
      gap: 8px !important;
      width: 100% !important;
    }

    .hero-editorial__btn {
      flex: 1 1 0px !important;
      padding: 12px 16px !important;
      font-size: 12px !important;
      font-weight: 700 !important;
      text-align: center !important;
      justify-content: center !important;
    }
  }

  @media (max-width: 480px) {
    .hero-editorial__heading {
      font-size: clamp(28px, 8vw, 42px) !important;
    }
    .hero-editorial__text {
      font-size: 13px !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hero = document.getElementById('HeroEditorial-{{ section.id }}');
    if (!hero) return;

    const filterLinks = hero.querySelectorAll('a[href*="type="], a.hero-editorial__btn, a.hero-editorial__corner-btn, a[href*="/pages/all-products"]');
    filterLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        try {
          const href = link.getAttribute('href');
          if (!href) return;
          const url = new URL(href, window.location.origin);

          if (url.pathname === window.location.pathname) {
            e.preventDefault();
            const targetType = url.searchParams.get('type') || '';
            window.history.pushState({}, '', url.pathname + (url.search ? url.search : ''));
            window.dispatchEvent(new CustomEvent('filterProductsByType', { detail: { type: targetType } }));

            const targetSection = document.querySelector('.new-in-section, .old-collections-section, .collection-products, .new-arrivals-section');
            if (targetSection) {
              const yOffset = -70;
              const y = targetSection.getBoundingClientRect().top + window.pageYOffset + yOffset;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }
          }
        } catch (err) {
          // Allow default link behavior on error
        }
      });
    });
  });
</script>
